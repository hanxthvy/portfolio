from "./components/ClickSpark.hsx" import ClickSpark
from "./components/BackgroundGrid3D.hsx" import BackgroundGrid3D
from "./components/Navbar.hsx" import Navbar
from "./components/Hero.hsx" import Hero
from "./components/About.hsx" import About
from "./components/Experience.hsx" import Experience
from "./components/Evidence.hsx" import Evidence
from "./components/TechStack.hsx" import TechStack
from "./components/Certificates.hsx" import Certificates
from "./components/Contact.hsx" import Contact

component App():
    ClickSpark(sparkColor="#f54e00", className="w-full min-h-screen bg-[#f7f7f4] text-[#26251e] font-sans selection:bg-[#26251e] selection:text-[#f7f7f4] relative"):
        BackgroundGrid3D()
        Navbar()
        main(className="relative z-10 flex-1"):
            Hero()
            About()
            Experience()
            Evidence()
            TechStack()
            Certificates()
            Contact()

from "react" import useEffect
from "./components/SplashBoot.hyx" import SplashBoot
from "./components/ClickSpark.hyx" import ClickSpark
from "./components/CircleSweep.hyx" import CircleSweep
from "./components/BackgroundGrid3D.hyx" import BackgroundGrid3D
from "./components/Navbar.hyx" import Navbar
from "./components/Hero.hyx" import Hero
from "./components/About.hyx" import About
from "./components/Projects.hyx" import Projects
from "./components/Experience.hyx" import Experience
from "./components/Evidence.hyx" import Evidence
from "./components/TechStack.hyx" import TechStack
from "./components/Contact.hyx" import Contact
from "./utils/revealEngine" import init_reveal

def block_context_menu():
    # Klik kanan dimatikan di seluruh halaman.
    #
    # Bukan proteksi -- isi halaman tetap bisa diambil lewat DevTools atau
    # view-source, dan itu bukan tujuannya. Yang dihilangkan adalah menu
    # bawaan browser (Simpan gambar, Inspect, Cetak) yang tidak relevan untuk
    # halaman ini dan merusak kesan "benda jadi".
    #
    # Pengecualian: kolom input dan area yang bisa diedit tetap mendapat menu
    # bawaan, karena di sana menu itu berguna (tempel, periksa ejaan).
    def on_context(e):
        t = e.target
        try:
            tag = str(t.tagName).upper()
            if tag in ("INPUT", "TEXTAREA") or (t.isContentEditable):
                return
        except:
            pass
        e.preventDefault()

    document.addEventListener("contextmenu", on_context)

    def cleanup():
        document.removeEventListener("contextmenu", on_context)
    return cleanup


component App():
    # Reveal dipasang sekali di akar halaman: satu IntersectionObserver untuk
    # semua elemen ber-atribut data_reveal, bukan satu observer per komponen.
    def reveal_effect():
        return init_reveal()

    useEffect(reveal_effect, [])

    def context_effect():
        return block_context_menu()

    useEffect(context_effect, [])

    ClickSpark(sparkColor="#cc785c", className="w-full min-h-screen bg-[#f7f7f4] text-[#26251e] font-sans selection:bg-[#26251e] selection:text-[#f7f7f4] relative"):
        SplashBoot()
        CircleSweep()
        BackgroundGrid3D()
        Navbar()
        main(className="relative z-10 flex-1"):
            Hero()
            # Hero bersifat position: fixed, jadi div ini yang menyediakan tinggi
            # gulir satu layar penuh; bukan spacer hiasan.
            div(className="w-full h-[100lvh] pointer-events-none")
            div(className="relative z-20 bg-[#f7f7f4] shadow-[0_-15px_35px_-5px_rgba(38,37,30,0.06)]"):
                About()
                Projects()
                Experience()
                Evidence()
                TechStack()
                Contact()

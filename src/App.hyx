from "./components/SplashScreen.hyx" import SplashScreen
from "./components/ClickSpark.hyx" import ClickSpark
from "./components/BackgroundGrid3D.hyx" import BackgroundGrid3D
from "./components/Navbar.hyx" import Navbar
from "./components/Hero.hyx" import Hero
from "./components/About.hyx" import About
from "./components/Projects.hyx" import Projects
from "./components/Experience.hyx" import Experience
from "./components/Evidence.hyx" import Evidence
from "./components/TechStack.hyx" import TechStack
from "./components/Contact.hyx" import Contact

component App():
    ClickSpark(sparkColor="#cc785c", className="w-full min-h-screen bg-[#f7f7f4] text-[#26251e] font-sans selection:bg-[#26251e] selection:text-[#f7f7f4] relative"):
        SplashScreen()
        BackgroundGrid3D()
        Navbar()
        main(className="relative z-10 flex-1"):
            Hero()
            div(className="w-full h-[100svh] pointer-events-none")
            div(className="relative z-20 bg-[#f7f7f4] shadow-[0_-15px_35px_-5px_rgba(38,37,30,0.06)]"):
                About()
                Projects()
                Experience()
                Evidence()
                TechStack()
                Contact()

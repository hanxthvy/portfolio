# [xihanzu-NR]
from "react" import useState, useEffect

component SplashScreen():
    is_mounted, set_is_mounted = useState(True)
    is_animating, set_is_animating = useState(False)

    def on_mount():
        try:
            if window.matchMedia("(prefers-reduced-motion: reduce)").matches:
                set_is_mounted(False)
                return None
        except:
            pass

        # Splash TIDAK boleh menunggu font.
        #
        # Dulu panel baru bergerak setelah `document.fonts.ready` selesai, dengan
        # plafon 900 ms sebagai jaring pengaman. Dua masalah nyata:
        #
        #   1. `fonts.ready` tidak pernah settle kalau satu request font gagal
        #      (offline, DNS diblokir, CDN diblokir). Diukur di mesin ini:
        #      fonts.gstatic.com mengembalikan net::ERR_FAILED, promise tidak
        #      resolve, jadi hanya plafon yang menyelamatkan.
        #   2. Plafon itu dijalankan SETELAH menunggu `fonts.ready`, sehingga
        #      efeknya bukan 900 ms melainkan "selama font masih loading".
        #
        # Splash adalah lapisan kosmetik di atas halaman yang sudah ter-render
        # (SSG). Tidak ada satu pun isinya yang butuh font. Jadi panel bergerak
        # tepat setelah frame pertama dicat, dan font hanya dipakai sebagai
        # percepatan kalau memang sudah siap — bukan sebagai gerbang.
        started = {"done": False}

        def start_anim():
            if started["done"]:
                return None
            started["done"] = True
            set_is_animating(True)

        # Jaring pengaman keras: apa pun yang terjadi, panel bergerak.
        t_ceiling = setTimeout(start_anim, 700)

        def begin_after_paint():
            raf = window.requestAnimationFrame
            if raf:
                raf(lambda _: raf(lambda _: setTimeout(start_anim, 40)))
            else:
                setTimeout(start_anim, 40)

        # Font yang sudah siap hanya mempercepat; tidak pernah menahan.
        try:
            if document.fonts and document.fonts.ready:
                document.fonts.ready.then(lambda _: begin_after_paint())
            else:
                begin_after_paint()
        except:
            begin_after_paint()

        # `begin_after_paint` juga dijadwalkan langsung, tidak menunggu font.
        begin_after_paint_timer = setTimeout(begin_after_paint, 0)

        def finish():
            set_is_mounted(False)
        t2 = setTimeout(finish, 2600)

        def cleanup():
            clearTimeout(t_ceiling)
            clearTimeout(t2)
            clearTimeout(begin_after_paint_timer)
        return cleanup

    useEffect(on_mount, [])

    if not is_mounted:
        return None

    def on_last_end(e):
        set_is_mounted(False)

    div(className="fixed inset-0 z-[9999] flex w-full h-[100dvh] pointer-events-none overflow-hidden select-none"):
        div(
            className=f"flex-1 bg-[#cc785c] will-change-transform transition-transform ease-[cubic-bezier(0.53,0,0.14,1)] duration-[1000ms] {'-translate-y-full' if is_animating else 'translate-y-0'}",
            style={"transitionDelay": "0ms", "marginRight": "-1px"}
        )
        div(
            className=f"flex-1 bg-[#cc785c] will-change-transform transition-transform ease-[cubic-bezier(0.53,0,0.14,1)] duration-[1000ms] {'-translate-y-full' if is_animating else 'translate-y-0'}",
            style={"transitionDelay": "200ms", "marginRight": "-1px"}
        )
        div(
            className=f"flex-1 bg-[#cc785c] will-change-transform transition-transform ease-[cubic-bezier(0.53,0,0.14,1)] duration-[1000ms] {'-translate-y-full' if is_animating else 'translate-y-0'}",
            style={"transitionDelay": "400ms", "marginRight": "-1px"}
        )
        div(
            onTransitionEnd=on_last_end,
            className=f"flex-1 bg-[#cc785c] will-change-transform transition-transform ease-[cubic-bezier(0.53,0,0.14,1)] duration-[1000ms] {'-translate-y-full' if is_animating else 'translate-y-0'}",
            style={"transitionDelay": "600ms", "marginRight": "-1px"}
        )
        div(
            onTransitionEnd=on_last_end,
            className=f"hidden md:block flex-1 bg-[#cc785c] will-change-transform transition-transform ease-[cubic-bezier(0.53,0,0.14,1)] duration-[1000ms] {'-translate-y-full' if is_animating else 'translate-y-0'}",
            style={"transitionDelay": "800ms"}
        )

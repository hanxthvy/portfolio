# [xihanzu-NR]
from "react" import useEffect, useRef
from "../utils/timeline" import clamp, trackOffset, stepSpring

# Deretan kartu horizontal yang digerakkan scroll.
#
# Pendekatannya mengikuti pola "track + sticky", bukan mengunci scroll dengan
# `position: fixed`.
#
# Kenapa berubah: tiga usaha sebelumnya memakai `position: fixed` pada body dan
# semuanya gagal di tahap yang sama -- listener tidak pernah terpasang, atau
# terkunci di posisi yang salah, atau halaman melompat. Yang terakhir terukur:
# nol listener wheel, sehingga seluruh mesin input diam tanpa pesan apa pun.
#
# Pola sticky tidak punya masalah itu karena tidak ada yang dikunci:
#
#   - Track dibuat LEBIH TINGGI dari stage. Selisihnya adalah "bahan bakar"
#     scroll untuk animasi.
#   - Stage `position: sticky; top: 0`, jadi ia menempel selama track lewat.
#   - Progres = seberapa jauh track sudah terlewati, dibagi tinggi ekstranya.
#
# Scroll tetap milik browser. Tidak ada `preventDefault`, tidak ada
# `overscroll-behavior`, tidak ada risiko halaman macet kalau ada yang gagal.
# Animasi tetap terasa "terkunci" karena stage tidak bergerak selama track
# bergulir.
#
# Satu-satunya listener adalah `scroll` pasif yang membaca satu angka.

KARTU_LEBAR = 0.90
CELAH = 0.12
# Di layar selebar ini ke atas, kartu berubah jadi dua kolom: teks di kiri,
# foto di kanan. Di bawahnya tetap satu kolom bertumpuk, karena dua kolom di
# layar sempit membuat teksnya terlalu sempit untuk dibaca.
AMBANG_DUA_KOLOM = 768

# Bagian lebar kartu yang dipakai foto pada tata letak dua kolom.
FOTO_KOLOM = 0.46

FOTO_TINGGI = 0.486
FOTO_KELUAR = 0.257

# Berapa kali tinggi stage dipakai sebagai bahan bakar animasi.
# 1.2 berarti animasi menghabiskan 120% tinggi layar tambahan sebelum selesai.
JARAK_SCROLL = 1.2

# Kekakuan dan redaman pegas yang menggerakkan kartu.
#
# Bukan batas kecepatan. Batas kecepatan hanya MEMOTONG: kartu lari di
# kecepatan maksimum lalu berhenti mendadak di ujung, dan sisa energi dari
# scroll cepat tetap terasa sebagai hentakan saat tiba.
#
# Pegas menyimpan momentum sebagai state, jadi scroll cepat memberi kartu
# kecepatan yang harus dibuang sedikit demi sedikit. Hasilnya kartu terus
# melaju sebentar setelah scroll berhenti, lalu melambat karena redaman.
#
# k=700, redaman=2*sqrt(700)=52.915 (redaman kritis). Terukur: seluruh rentang
# ditempuh ~0.60 s pada 60fps, tanpa overshoot, berhenti bersih.
#
# Versi pertama memakai k=200 (0.95 s) dan terasa terlalu mengambang -- kartu
# masih melaju jauh setelah jari berhenti. Pegas yang lebih kaku mengikuti jari
# lebih rapat, jadi efek "melayang"-nya berkurang.
PEGAS_K = 700.0
PEGAS_REDAMAN = 52.915

# Seberapa awal animasi sudah berjalan SEBELUM stage menempel.
#
# 0.2 berarti: ketika stage masih 20% tinggi layar di bawah titik tempelnya,
# kartu sudah mulai bergeser. Scroll terakhir sebelum menempel sudah
# menggerakkan animasi, jadi tidak ada momen "diam lalu melompat".
#
# Kenapa perlu: tanpa ini, kartu diam total sampai stage menempel, dan gerakan
# pertama datang sekaligus -- terasa seperti kunci yang menyambar. Dengan
# awalan, gerakannya menyambung dari scroll biasa.
AWALAN = 0.2


component ScrollCards(items=None, on_open=None):
    if items == None:
        items = []

    stage_ref = useRef(None)
    track_ref = useRef(None)
    baris_ref = useRef(None)

    def on_mount():
        stage = stage_ref.current
        track = track_ref.current
        baris = baris_ref.current
        if not stage or not track or not baris:
            return lambda: None

        try:
            if window.matchMedia("(prefers-reduced-motion: reduce)").matches:
                # Tanpa animasi: kartu ditata sekali, track tidak diberi tinggi
                # ekstra, jadi scroll tidak terasa aneh di section ini.
                track.style.height = "auto"
                return lambda: None
        except:
            pass

        st = {"p": -1.0, "raf": 0, "sekarang": 0.0, "target": 0.0, "waktu": 0.0, "v": 0.0, "kw": 0.0, "jarak": 0.0, "kiri": [], "wadah": 0.0, "tampil": []}

        # Hanya satu loop yang boleh hidup, dan boleh dipanggil berulang.
        loop = {"id": 0}

        def tinggi_header():
            # Tinggi header diukur dari elemennya, bukan ditebak dari angka.
            #
            # Header-nya `fixed`, jadi ia menutupi bagian atas viewport. Kalau
            # stage memakai `innerHeight` penuh, judul section tertimpa header
            # dan tidak pernah terlihat -- terukur pada tinggi 64px.
            # Header di proyek ini adalah `<div>` dengan `position: fixed`,
            # BUKAN `<header>` atau `<nav>`.
            #
            # Percobaan pertama mencari `document.querySelector("header")`
            # lebih dulu. Elemen itu ADA (dan `offsetHeight`-nya 0 karena kosong
            # atau tersembunyi), sehingga pencarian cadangan tidak pernah
            # dijalankan -- hasilnya tinggi header dianggap 0 dan stage tetap
            # setinggi viewport penuh. Terukur: stage 900px, header 65px, jadi
            # 65px atas tertimpa.
            #
            # Yang dipakai: ukur SEMUA kandidat, ambil yang tingginya masuk akal.
            try:
                for el in document.querySelectorAll("header, nav, div"):
                    cs = window.getComputedStyle(el)
                    if cs.position != "fixed" or cs.top != "0px":
                        continue
                    h = el.offsetHeight or 0
                    # 40..140: cukup tinggi untuk header, cukup rendah untuk
                    # bukan panel atau overlay layar penuh.
                    if h > 40 and h < 140:
                        return h
            except:
                pass
            return 0

        def tulis_kartu():
            # Ukuran kartu HANYA dihitung ulang saat ukuran wadah berubah.
            #
            # Sebelumnya ini ada di dalam `posisi()`, jadi setiap frame
            # membaca `getBoundingClientRect()` per kartu setelah menulis
            # transform -- itu memaksa layout sinkron di setiap frame, dan di
            # desktop (yang menjalankan lebih banyak frame per detik) hasilnya
            # terlihat sebagai glitch: kartu berkedip dan melompat.
            #
            # Layout read setelah layout write dalam satu frame adalah sumber
            # utama "layout thrashing". Dipisah, satu frame hanya menulis
            # transform.
            wadah = baris.clientWidth
            layar = window.innerWidth or wadah
            dua_kolom = layar >= AMBANG_DUA_KOLOM
            kw = layar * KARTU_LEBAR
            # Kartu tidak boleh lebih lebar dari wadahnya, kalau tidak sisi
            # kanannya dipotong `overflow: hidden` berapa pun posisinya.
            if kw > wadah:
                kw = wadah
            jarak = kw * (1 + CELAH)
            st["kw"] = kw
            st["jarak"] = jarak
            st["geser"] = trackOffset(len(items), jarak, st["sekarang"])

            kiri = []
            for i in range(len(baris.children)):
                el = baris.children[i]
                el.style.width = f"{kw:.2f}px"
                x_kartu = (wadah - kw) / 2 + i * jarak
                el.style.left = f"{x_kartu:.2f}px"
                kiri.append(x_kartu)

                # Ukuran foto DIHITUNG dalam piksel, dari tinggi kartu.
                #
                # Versi sebelumnya memakai persen (`top: -25.7%`,
                # `height: 48.6%`). Persen pada `top` dihitung dari tinggi
                # INDUK, sedangkan `height: 100%` pada badan kartu membuat
                # induknya setinggi kartu -- jadi `top: -25.7%` berarti 25.7%
                # dari tinggi kartu, bukan dari tinggi foto. Hasilnya foto
                # terdorong 248px ke bawah dan terlihat seperti celah kosong
                # besar di dalam kartu.
                badan = el.querySelector(".kartu-badan")
                if not badan:
                    continue
                th = badan.getBoundingClientRect().height
                if th <= 0:
                    continue
                foto = badan.querySelector("[data-foto]")
                teks = badan.querySelector("[data-teks]")

                if dua_kolom:
                    # Layar lebar: teks di kiri, foto di kanan, dua-duanya
                    # setinggi kartu.
                    #
                    # Tata letak vertikal (foto menonjol ke atas, teks di
                    # bawahnya) hanya masuk akal kalau kartu sempit dan
                    # tinggi. Di desktop kartu jadi lebar dan pendek, dan
                    # foto yang menonjol ke atas cuma memakan ruang teks.
                    if foto:
                        foto.style.top = "0px"
                        foto.style.height = "100%"
                        foto.style.left = "auto"
                        foto.style.right = "0"
                        foto.style.width = f"{FOTO_KOLOM * 100:.1f}%"
                        foto.style.borderRadius = "0 14px 14px 0"
                    if teks:
                        teks.style.top = "0"
                        teks.style.height = "100%"
                        teks.style.right = "auto"
                        teks.style.width = f"{(1 - FOTO_KOLOM) * 100:.1f}%"
                        teks.style.justifyContent = "center"
                    badan.style.marginTop = "0px"
                else:
                    # Layar sempit: foto menonjol ke atas kartu, teks di
                    # bawahnya -- seperti sebelumnya.
                    if foto:
                        foto.style.top = f"{-FOTO_KELUAR * th:.1f}px"
                        foto.style.height = f"{FOTO_TINGGI * th:.1f}px"
                        foto.style.left = "0"
                        foto.style.right = "0"
                        foto.style.width = "auto"
                        foto.style.borderRadius = "10px"
                    if teks:
                        teks.style.top = f"{(FOTO_TINGGI - FOTO_KELUAR) * 100:.1f}%"
                        teks.style.height = "auto"
                        teks.style.right = "0"
                        teks.style.width = "auto"
                        teks.style.justifyContent = "flex-start"
                    # Badan kartu bergeser turun sebesar bagian foto yang
                    # menonjol, supaya foto tidak terpotong wadah.
                    badan.style.marginTop = f"{FOTO_KELUAR * th:.1f}px"

            st["kiri"] = kiri
            st["wadah"] = wadah

        def ukur():
            vh = window.innerHeight or 800
            tinggi = vh - tinggi_header()
            # Stage setinggi viewport DIKURANGI header, dan ditempel di bawah
            # header (`top: header`), bukan di 0.
            stage.style.height = f"{tinggi}px"
            stage.style.top = f"{tinggi_header()}px"
            # Tinggi track diturunkan dari geometrinya.
            #
            # Stage berhenti menempel ketika
            #   top == header - (tinggi_track - tinggi_stage)
            # dan progres mencapai 1 ketika
            #   top == header - vh * (JARAK_SCROLL + AWALAN)
            #
            # Supaya keduanya jatuh di titik yang sama, tinggi ekstra harus
            #   vh * JARAK_SCROLL
            # karena `AWALAN * vh` sudah terpakai sebagai jarak pra-gulir
            # SEBELUM stage menempel.
            #
            # Versi sebelumnya memakai `vh * (JARAK_SCROLL + AWALAN)`. Itu
            # menghitung jarak pra-gulir dua kali: sekali lewat `awal` di
            # `baca()`, sekali lagi lewat tinggi ekstra. Terukur di 857px:
            # progres 1 pada top -963, stage lepas pada top -1135 -- 171px
            # scroll mati setelah kartu terakhir sampai di tengah.
            track.style.height = f"{tinggi + vh * JARAK_SCROLL}px"
            # Ukuran kartu bergantung pada lebar wadah, jadi ikut dihitung
            # ulang di sini -- bukan di dalam `posisi()`.
            tulis_kartu()

        def posisi(p):
            # Fungsi ini dipanggil tiap frame, jadi isinya sengaja seminimal
            # mungkin: hitung satu angka, tulis satu transform.
            #
            # Tidak ada `getBoundingClientRect`, tidak ada `clientWidth`, tidak
            # ada pembacaan layout sama sekali. Semua nilai yang dibutuhkan
            # sudah disimpan oleh `tulis_kartu()` saat mount / resize.
            if abs(p - st["p"]) < 0.0002:
                return
            st["p"] = p
            st["sekarang"] = p
            geser = trackOffset(len(items), st["jarak"], p) if st["jarak"] > 0 else 0.0
            baris.style.transform = f"translate3d({geser:.2f}px,0,0)"


        def baca():
            # Progres = seberapa jauh track sudah lewat MELAMPAUI titik tempel.
            #
            # Titik nolnya BUKAN `top == 0`, melainkan `top == tinggi header`.
            # Stage menempel di `top: header`, jadi perjalanan animasi baru
            # dimulai ketika track mencapai angka itu -- sebelumnya stage masih
            # bergerak naik bersama halaman, dan kalau progres dihitung dari 0,
            # kartu sudah bergeser saat stage belum menempel.
            #
            # Itu gejala yang terukur: scroll dari atas terlihat "kunci dulu
            # baru geser", sementara scroll dari bawah terlihat benar karena
            # arahnya sudah melewati titik itu.
            vh = window.innerHeight or 800
            # Rentang diperpanjang sebesar AWALAN, sehingga progres mulai
            # bergerak saat track masih `AWALAN * vh` di bawah titik tempel.
            span = vh * (JARAK_SCROLL + AWALAN)
            if span <= 0:
                return 1.0
            top = track.getBoundingClientRect().top
            mulai = tinggi_header()
            # `mulai + AWALAN * vh` = titik di mana progres == 0.
            awal = mulai + vh * AWALAN
            return clamp((awal - top) / span, 0.0, 1.0)

        def sekarang_ms():
            return window.performance.now() if window.performance else Date.now()

        def langkah(_=None):
            # Satu langkah loop: majukan `sekarang` ke arah `target`, paling
            # jauh KECEPATAN_MAKS per detik, lalu gambar hasilnya.
            #
            # Ini yang menghilangkan hentakan. Scroll tetap menentukan TUJUAN,
            # tapi kartu sampai ke sana dengan kecepatan terbatas, bukan
            # seketika. Kalau user berhenti scroll, kartu tetap menyusul dan
            # berhenti tepat di target.
            loop["id"] = 0
            kini = sekarang_ms()
            dt = 0.0
            if st["waktu"] > 0:
                dt = (kini - st["waktu"]) / 1000.0
            # Batasi dt: kalau tab sempat tidak aktif, selisih waktunya bisa
            # beberapa detik dan satu langkah akan melompat jauh.
            if dt > 0.1:
                dt = 0.1
            if dt < 0:
                dt = 0
            st["waktu"] = kini

            # Pegas, bukan limiter. Kecepatan (`st["v"]`) ikut disimpan, itulah
            # yang membuat sisa energi scroll cepat teredam perlahan alih-alih
            # dipangkas di ujung.
            #
            # Sebelumnya di sini ada `batas <= 0 -> langsung ke target`, dan
            # karena frame pertama selalu `dt == 0`, cabang itu terpakai tepat
            # di frame paling penting dan mematikan peredamnya sepenuhnya.
            hasil = stepSpring(st["sekarang"], st["v"], st["target"], dt, PEGAS_K, PEGAS_REDAMAN)
            st["sekarang"] = hasil["x"]
            st["v"] = hasil["v"]

            posisi(st["sekarang"])

            # Masih ada sisa -> lanjutkan loop. Kalau sudah sampai, berhenti
            # supaya tidak ada rAF yang jalan terus tanpa guna.
            if abs(st["target"] - st["sekarang"]) > 0.0002 or abs(st["v"]) > 0.002:
                raf = window.requestAnimationFrame
                if raf:
                    loop["id"] = raf(langkah)

        def on_scroll(_=None):
            st["target"] = baca()
            if loop["id"]:
                return
            raf = window.requestAnimationFrame
            if raf:
                # Waktu di-seed sekarang, bukan 0: kalau 0, frame pertama
                # selalu `dt == 0` dan peredam tidak bergerak sama sekali.
                st["waktu"] = sekarang_ms()
                loop["id"] = raf(langkah)
            else:
                # Tanpa rAF (lingkungan tes), langsung ke target.
                st["sekarang"] = st["target"]
                posisi(st["sekarang"])

        def ke_target(p):
            # Loncat tanpa animasi - dipakai saat mount dan resize, supaya
            # halaman yang dibuka di tengah section tidak ikut "mengejar".
            st["target"] = p
            st["sekarang"] = p
            st["v"] = 0.0
            st["waktu"] = 0.0
            posisi(p)

        def on_resize(_=None):
            ukur()
            ke_target(baca())

        ukur()
        ke_target(baca())
        window.addEventListener("scroll", on_scroll, {"passive": True})
        window.addEventListener("resize", on_resize, {"passive": True})

        def cleanup():
            if loop["id"]:
                try:
                    window.cancelAnimationFrame(loop["id"])
                except Exception:
                    pass
                loop["id"] = 0
            window.removeEventListener("scroll", on_scroll)
            window.removeEventListener("resize", on_resize)
            if st["raf"]:
                window.cancelAnimationFrame(st["raf"])
        return cleanup

    useEffect(on_mount, [])

    # Track (tinggi, tempat scroll berjalan) membungkus stage (menempel).
    div(className="relative w-full"):
        div(ref=track_ref, className="relative w-full"):
            # Stage: judul di atas, deretan kartu memakai sisa tingginya.
            #
            # Sebelumnya stage hanya berisi kartu, jadi selama animasi berjalan
            # satu viewport penuh terisi kartu saja tanpa konteks -- pengunjung
            # tidak tahu sedang melihat bagian apa. Judul ikut ditempel karena
            # ia ada di dalam stage yang sama.
            div(
                ref=stage_ref,
                className="sticky top-0 w-full overflow-hidden flex flex-col",
            ):
                # Judul section. Tingginya tetap (`shrink-0`) supaya kartu yang
                # menyesuaikan, bukan judulnya.
                div(className="shrink-0 pt-16 pb-0 px-6 max-w-[1200px] w-full mx-auto"):
                    span(className="text-[10px] sm:text-[11px] font-mono tracking-[0.88px] uppercase text-[#a9583e] block mb-1.5"):
                        "// ARSIP & KREDENSIAL"
                    h2(className="text-[22px] sm:text-[30px] font-semibold leading-[1.15] text-[#26251e]"):
                        "Dokumentasi & Sertifikasi"
                    p(className="text-[12px] sm:text-[14px] text-[#5a5852] leading-[1.45] mt-1 max-w-2xl"):
                        "Kredensial resmi, homelab, dan hasil oprek perangkat yang pernah saya kerjakan."

                # Sisa tinggi setelah judul. `min-h-0` wajib: tanpa itu flex
                # item menolak menyusut dan kartu meluber keluar stage.
                # Kartu menempel ke ATAS area ini, bukan ke tengahnya.
                #
                # `items-center` pada wadah setinggi sisa viewport menaruh baris
                # kartu di tengah, menyisakan celah kosong besar di atasnya.
                # Terukur: deskripsi berakhir di y=210, kartu baru mulai di 346
                # -- 136px kosong yang terlihat seperti jarak yang salah.
                #
                # Dengan `items-start`, celah itu hilang dan tinggi kartu
                # menentukan sisanya.
                # Kartu mengisi SISA tinggi, tidak dipatok persentase.
                #
                # Dengan `height: 62%` dari wadah yang tingginya = sisa
                # viewport, kartu jadi 415px di layar 900 -- terlalu pendek,
                # dan itu juga sumber celah yang terlihat: persentase tinggi
                # dihitung dari wadah yang sudah dipotong judul, jadi angkanya
                # mengecil dua kali.
                #
                # `height: 100%` pada baris, di dalam wadah yang `flex-1`,
                # membuat kartu memakai semua ruang yang tersisa setelah judul.
                div(className="flex-1 min-h-0 w-full flex items-stretch justify-center pt-3 pb-2"):
                    div(
                        ref=baris_ref,
                        className="relative w-full will-change-transform",
                        style={"height": "100%", "--kartu-h": "100%", "transform": "translate3d(0,0,0)"},
                    ):
                        for i in range(len(items)):
                            div(
                                key=items[i]["id"],
                                className="absolute top-1/2 -translate-y-1/2",
                                style={"height": "100%"},
                            ):
                                div(
                                    className="relative h-full flex flex-col cursor-pointer",
                                    onClick=lambda it=items[i]: (on_open(it) if (on_open != None and it["image"] != None) else None),
                                ):
                                    div(
                                        className="relative w-full flex-1 rounded-[14px] border border-[#e6e5e0] bg-white shadow-sm kartu-badan",
                                        style={"marginTop": "0"},
                                    ):
                                        div(
                                            className="absolute left-0 right-0 overflow-hidden rounded-[10px] bg-[#fafaf7] border border-[#e6e5e0]",
                                            data_foto="1",
                                            style={},
                                        ):
                                            if items[i]["image"] != None:
                                                # TANPA `loading="lazy"`.
                                                #
                                                # Lazy loading memutuskan kapan
                                                # memuat berdasarkan posisi
                                                # elemen di LAYOUT. Di sini
                                                # gambar berada di dalam wadah
                                                # yang digeser `transform`, dan
                                                # transform tidak mengubah
                                                # layout -- jadi browser
                                                # menganggap semua kartu masih
                                                # di tempat asalnya. Akibatnya
                                                # gambar baru dimuat ketika
                                                # kartunya sudah tampil, dan
                                                # yang terlihat adalah kotak
                                                # kosong lalu gambar muncul
                                                # mendadak: persis "blinking".
                                                #
                                                # Terukur: ketiga gambar
                                                # `complete: false`,
                                                # `naturalWidth: 0` saat
                                                # animasi mulai.
                                                #
                                                # `decoding="sync"` juga
                                                # disengaja: `async` berarti
                                                # gambar boleh tampil setelah
                                                # decode selesai, dan pada
                                                # layer yang bergerak itu
                                                # terlihat sebagai kedipan.
                                                img(
                                                    src=items[i]["image"],
                                                    alt=items[i]["title"],
                                                    loading="eager",
                                                    decoding="sync",
                                                    className="w-full h-full object-cover",
                                                )
                                            else:
                                                div(className="w-full h-full flex items-center justify-center px-4 text-center"):
                                                    span(className="text-[10px] font-mono text-[#6c6a64] leading-relaxed"):
                                                        "// FOTOGRAFI TIDAK DIIZINKAN"

                                        div(
                                            className="absolute left-0 right-0 bottom-0 p-5 sm:p-6 flex flex-col",
                                            data_teks="1",
                                            style={"top": f"{(FOTO_TINGGI - FOTO_KELUAR) * 100:.1f}%"},
                                        ):
                                            span(className="text-[10px] font-mono tracking-[0.6px] uppercase text-[#a9583e] mb-2"):
                                                items[i]["category"]
                                            h3(className="text-[15px] sm:text-[18px] font-semibold leading-[1.3] text-[#26251e] mb-2"):
                                                items[i]["title"]
                                            p(className="text-[11px] sm:text-[13px] font-normal leading-[1.55] text-[#5a5852]"):
                                                items[i]["description"]

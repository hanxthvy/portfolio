component Experience():
    section(id="experience", className="py-24 px-6 max-w-[1200px] mx-auto border-t border-[#e6e5e0] text-left"):
        # Header
        div(className="max-w-3xl mb-14"):
            p(className="text-[11px] font-semibold font-mono tracking-[0.88px] uppercase text-[#807d72] mb-2"):
                "// RIWAYAT & PENGALAMAN"
            h2(className="text-3xl sm:text-[36px] font-normal leading-[1.2] tracking-[-0.72px] text-[#26251e] mb-4"):
                "Pengalaman Magang & Proyek Mandiri"
            p(className="text-base font-normal leading-[1.5] text-[#5a5852]"):
                "Catatan pengalaman magang di industri manufaktur serta proyek eksplorasi teknis yang saya kerjakan secara mandiri."

        # Tabular Timeline
        div(className="border-t border-[#e6e5e0] divide-y divide-[#e6e5e0]"):
            for exp in experiences_data:
                div(
                    key=exp["role"],
                    className="py-8 sm:py-10 text-left transition-colors",
                ):
                    h3(className="text-[19px] sm:text-[21px] font-semibold leading-[1.3] text-[#26251e] mb-2"):
                        exp["role"]
                    p(className="text-sm font-normal text-[#5a5852] leading-[1.6] mb-4"):
                        exp["focus"]
                    ul(className="space-y-2.5"):
                        for item in exp["impact"]:
                            li(key=item, className="text-sm font-normal text-[#5a5852] leading-[1.55] flex items-start gap-2.5"):
                                span(className="text-[#f54e00] font-mono text-xs pt-1 select-none"):
                                    "—"
                                span(): item

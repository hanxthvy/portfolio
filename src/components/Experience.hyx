# [xihanzu-NR]

experiences_data = [
    {
        "role": "Industrial Intern – Mounting & Cutting PCB Audio",
        "focus": "Pemasangan (mounting) komponen elektronika dan pemotongan (cutting) panel PCB audio industri di PT Panasonic Manufacturing Indonesia.",
        "impact": [
            "Menyelesaikan masa Praktik Kerja Lapangan (PKL) di Business Unit Audio bagian PCB Assembly (Mounting & Cutting) periode November 2025 – Januari 2026.",
            "Meraih nilai akhir 94.3% (Grade A) mencakup aspek disiplin, mutu kerja, sikap, inisiatif, dan teknis.",
            "Mempelajari standar alur produksi manufaktur elektronika dan ketelitian penempatan komponen fisik.",
        ],
    },
    {
        "role": "HydraScript – Compiler Toolchain (Personal Project)",
        "focus": "Proyek eksplorasi pembuatan compiler sederhana berbasis Rust untuk mentranspilasi sintaks Pythonic menjadi TSX dan ES modules.",
        "impact": [
            "Merancang parser AST dan generator kode untuk komponen UI berbasis web.",
            "Membuat plugin integrasi Vite untuk kompilasi berkas .hyx secara lokal saat development.",
            "Memahami konsep dasar perancangan bahasa, tokenisasi, dan transformasi sintaks.",
        ],
    },
    {
        "role": "Homelab & Bare-Metal Server (HPE ProLiant DL360 Gen9)",
        "focus": "Pengelolaan server fisik rack 1U HPE ProLiant DL360 Gen9 di kamar berbasis Proxmox VE 8, tunneling WireGuard via VPS untuk bypass CGNAT, dan node hosting Pterodactyl.",
        "impact": [
            "Mengonfigurasi tunnel WireGuard ke VPS publik untuk bypass CGNAT ISP rumah sehingga server lokal mendapatkan akses IP publik dedicated.",
            "Menjalankan node web dan game hosting berbasis Pterodactyl Panel serta beberapa container LXC di atas host fisik RAM 15.5GB.",
            "Mengelola administrasi Linux, pemantauan resource CPU/RAM, dan troubleshooting routing jaringan secara mandiri.",
        ],
    },
    {
        "role": "Android Flashing & Kernel Overclocking (itel RS4)",
        "focus": "Eksperimen flashing custom ROM AxionOS 2.6 (AOSP) dan tuning kernel untuk memaksimalkan performa harian smartphone.",
        "impact": [
            "Melakukan flashing custom ROM AOSP AxionOS 2.6 berbasis Android pada smartphone itel RS4 Helio G99.",
            "Menerapkan konfigurasi overclocking kernel dan penyesuaian governor CPU/GPU.",
            "Mengecek stabilitas sistem, konsumsi daya, dan suhu perangkat saat pengujian performa.",
        ],

# [xihanzu-NR]

experiences_data = [
    {
        "role": "Industrial Intern – Assembly & Quality Control PCB Audio",
        "organization": "PT Panasonic Manufacturing Indonesia",
        "period": "Nov 2025 – Jan 2026",
        "focus": "Pemasangan komponen presisi dan pemotongan panel PCB audio di lini perakitan manufaktur elektronik berstandar industri internasional.",
        "impact": [
            "Menyelesaikan program Praktik Kerja Lapangan (PKL) di Business Unit Audio dengan predikat kelulusan Grade A (Nilai Akhir 94.3 / 100).",
            "Menerapkan kedisiplinan dan standar mutu manufaktur tinggi dalam proses penempatan komponen fisik serta toleransi pemotongan panel PCB.",
            "Berpengalaman bekerja dalam alur kerja industri profesional dengan komunikasi tim yang terstruktur dan kepatuhan SOP pabrik.",
        ],
    },
]

component Experience():
    section(id="experience", className="py-24 px-6 max-w-[1200px] mx-auto border-t border-[#e6e5e0] text-left"):
        div(className="max-w-3xl mb-14"):
            p(className="text-[11px] font-semibold font-mono tracking-[0.88px] uppercase text-[#807d72] mb-2"):
                "// RIWAYAT & PENGALAMAN KERJA"
            h2(className="text-3xl sm:text-[36px] font-normal leading-[1.2] tracking-[-0.72px] text-[#26251e] mb-4"):
                "Pengalaman Industri"
            p(className="text-base font-normal leading-[1.5] text-[#5a5852]"):
                "Riwayat pengalaman magang di dunia industri manufaktur manufaktur elektronik profesional."

        div(className="border-t border-[#e6e5e0] divide-y divide-[#e6e5e0]"):
            for exp in experiences_data:
                div(
                    key=exp["role"],
                    className="py-8 sm:py-10 text-left transition-colors",
                ):
                    div(className="flex flex-col sm:flex-row sm:items-baseline sm:justify-between gap-1 mb-2"):
                        h3(className="text-[20px] sm:text-[22px] font-semibold leading-[1.3] text-[#26251e]"):
                            exp["role"]
                        span(className="text-xs font-mono text-[#807d72]"):
                            exp["period"]

                    p(className="text-xs font-mono text-[#f54e00] mb-3"):
                        exp["organization"]

                    p(className="text-sm font-normal text-[#5a5852] leading-[1.65] mb-5 max-w-3xl"):
                        exp["focus"]

                    ul(className="space-y-2.5"):
                        for item in exp["impact"]:
                            li(key=item, className="text-sm font-normal text-[#5a5852] leading-[1.55] flex items-start gap-2.5"):
                                span(className="text-[#f54e00] font-mono text-xs pt-1 select-none"):
                                    "—"
                                span(): item

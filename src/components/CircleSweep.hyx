# [xihanzu-NR]
from "react" import useState, useEffect, useRef
from "gsap" import gsap

# Sapuan lingkaran diagonal sebagai transisi antar section.
#
# Animasi dijalankan GSAP, BUKAN CSS @keyframes, dan alasannya penting:
#
#   Rencana awal memakai keyframes yang membaca variabel CSS
#   (--sweep-move-x dst). Itu gagal di HydraScript: properti bertanda hubung
#   di objek `style` JSX tidak tertulis ke atribut style sama sekali, jadi
#   nilainya terbaca kosong dan lingkaran menguncup di tempat. Sudah dicatat
#   di vault Obsidian, "Limitasi HydraScript".
#
#   GSAP menulis transform sendiri, langsung ke elemen, tanpa lewat variabel.
#   Jadi tidak ada lapisan yang bisa menelan nilainya.
#
# Konsekuensi lain yang menguntungkan: kurva bezier dari contoh Alight Motion
# bisa dipakai apa adanya lewat `CustomEase`-style cubic-bezier string GSAP
# ("cubic-bezier(...)"), dan pembatalan animasi jadi eksplisit.
component CircleSweep(color="var(--color-primary, #cc785c)", on_reveal=None):
    phase, set_phase = useState("idle")
    target_ref = useRef(None)
    corner_ref = useRef("bottom-right")
    circle_ref = useRef(None)
    tween_ref = useRef(None)

    def viewport():
        try:
            return window.innerWidth, window.innerHeight
        except:
            return 1080, 2400

    def corner_xy(corner_name, w, h):
        # Koordinat pusat lingkaran untuk tiap sudut layar.
        if corner_name == "top-left":
            return 0.0, 0.0
        if corner_name == "top-right":
            return w, 0.0
        if corner_name == "bottom-left":
            return 0.0, h
        return w, h

    def opposite_xy(corner_name, w, h):
        if corner_name == "top-left":
            return w, h
        if corner_name == "top-right":
            return 0.0, h
        if corner_name == "bottom-left":
            return w, 0.0
        return 0.0, 0.0

    def cover_scale(w, h):
        # Skala minimum agar lingkaran berpusat di satu sudut menutupi layar.
        #
        # Elemen dasarnya 100px, jadi jari-jari setelah diskalakan = 50*s.
        # Titik terjauh dari sudut adalah sudut seberang, jaraknya diagonal.
        # Maka 50*s >= diagonal -> s >= 2*diagonal/100.
        #
        # 1.08 sebagai margin: pembulatan subpiksel pernah menyisakan sudut
        # yang belum tertutup saat angkanya pas.
        diagonal = ((w * w + h * h) ** 0.5)
        return (2.0 * diagonal / 100.0) * 1.08

    def place(scale, cx, cy):
        # GSAP bekerja pada transform elemen. Elemen 100px, transform-origin
        # di tengah, jadi translate harus memuat (pusat - 50) supaya pusat
        # lingkaran jatuh tepat di koordinat yang diminta.
        c = circle_ref.current
        if not c:
            return
        gsap.set(c, {"x": cx - 50, "y": cy - 50, "scale": scale, "opacity": 1})

    def finish_phase():
        if phase == "grow":
            handle_grown()
        else:
            handle_shrunk()

    def handle_grown():
        t = target_ref.current
        root_el = document.documentElement
        prev = root_el.style.scrollBehavior
        # `scroll-behavior: smooth` di html berlaku untuk SEMUA scroll,
        # termasuk yang meminta `behavior: "auto"`. Tanpa dimatikan, halaman
        # tetap meluncur pelan selama ~1 detik tepat saat lingkaran menutup.
        root_el.style.scrollBehavior = "auto"

        if t == "top" or not t:
            window.scrollTo({"top": 0, "behavior": "auto"})
        else:
            el = document.getElementById(str(t).replace("#", ""))
            if el:
                el.scrollIntoView({"behavior": "auto"})

        def restore():
            root_el.style.scrollBehavior = prev
        window.requestAnimationFrame(lambda _: restore())

        def shrink():
            set_phase("shrink")
        window.requestAnimationFrame(lambda _: window.requestAnimationFrame(lambda _: shrink()))

    def handle_shrunk():
        set_phase("idle")
        if on_reveal:
            on_reveal()

    def go(target, corner_name):
        target_ref.current = target
        c = corner_name or "bottom-right"
        corner_ref.current = c
        set_phase("grow")

    def expose_bridge():
        # Navbar memanggil ini tanpa berbagi state React.
        #
        # Sengaja tidak dibersihkan lewat cleanup: React memanggil cleanup pada
        # setiap efek berikutnya, dan itu pernah membuat fungsinya hilang
        # setelah render kedua sehingga navigasi jatuh ke scroll biasa.
        window.__hydraSweep = lambda target, corner_name: go(target, corner_name)
        return lambda: None

    useEffect(expose_bridge, [])

    def run_phase():
        # Dijalankan setiap fase berganti, saat elemennya sudah ada di DOM.
        if phase == "idle":
            return lambda: None

        c = circle_ref.current
        if not c:
            return lambda: None

        w, h = viewport()
        s = cover_scale(w, h)
        sx, sy = corner_xy(corner_ref.current, w, h)
        ex, ey = opposite_xy(corner_ref.current, w, h)

        # Selalu mulai dari keadaan awal, supaya klik beruntun tidak
        # melanjutkan tween yang setengah jalan.
        if tween_ref.current:
            tween_ref.current.kill()
            tween_ref.current = None
        gsap.killTweensOf(c)

        if phase == "grow":
            place(0, sx, sy)
            # Kurva mengembang dari contoh: ease-out, cepat lalu mengendap.
            tween_ref.current = gsap.to(c, {
                "scale": s,
                "duration": 0.62,
                "ease": "power2.out",
                "onComplete": lambda: finish_phase(),
            })
        else:
            place(s, sx, sy)
            # Menguncup sekaligus bergerak ke sudut seberang.
            #
            # Kurvanya dua: skala ease-out seperti contoh, posisi memakai
            # "tahan lalu sambar" — di paruh waktu progres baru ~0.9%, jadi
            # lingkaran hampir diam lalu melesat. Itu yang membuat sapuannya
            # terasa seperti contoh Alight Motion, bukan geseran rata.
            tween_ref.current = gsap.to(c, {
                "x": ex - 50,
                "y": ey - 50,
                "scale": 0,
                "duration": 0.72,
                "ease": "power2.inOut",
                "onComplete": lambda: finish_phase(),
            })

        return lambda: None

    useEffect(run_phase, [phase])

    def watch_resize():
        def onresize(e):
            if phase != "idle":
                set_phase(phase)
        window.addEventListener("resize", onresize)

        def cleanup():
            window.removeEventListener("resize", onresize)
        return cleanup

    useEffect(watch_resize, [phase])

    if phase == "idle":
        return None

    div(
        ref=circle_ref,
        className="circle-sweep",
        aria_hidden=True,
        style={
            "position": "fixed",
            "left": "0",
            "top": "0",
            "zIndex": "9998",
            "width": "100px",
            "height": "100px",
            "borderRadius": "50%",
            "backgroundColor": color,
            "pointerEvents": "none",
            "transformOrigin": "center center",
            "willChange": "transform",
        },
    )

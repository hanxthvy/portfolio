from "./ScrollCards.hyx" import ScrollCards

artifacts_data = [
    {
        "id": "panasonic-cert",
        "title": "Sertifikat Fisik PKL Industri & Dicoding",
        "category": "Credentials",
        "image": "/images/PXL_20260403_113133217.webp",
        "description": "Dokumentasi sertifikat fisik Praktik Kerja Lapangan di PT Panasonic Manufacturing Indonesia (Audio PCB Assembly, Nilai 94.3 / Grade A) dan sertifikat kelulusan back-end dari Dicoding Indonesia.",
        "metrics": "Nilai: 94.3 / 100 · 3 Bulan PKL",
    },
    {
        "id": "proxmox-telemetry",
        "title": "Homelab HPE ProLiant DL360 Gen9 & Pterodactyl",
        "category": "Infrastructure",
        "image": "/images/VID_20260514105929529.webp",
        "description": "Dokumentasi live telemetry monitor Proxmox VE pada server fisik rack 1U HPE ProLiant DL360 Gen9 di kamar yang difungsikan sebagai node hosting Pterodactyl melalui tunnel WireGuard VPS (bypass CGNAT).",
        "metrics": "HPE DL360 Gen9 · WireGuard CGNAT Bypass · Pterodactyl",
    },
    {
        "id": "axion-rom",
        "title": "Custom ROM AxionOS & Overclocking itel RS4",
        "category": "Mobile & Firmware",
        "image": "/images/PXL_20260528_190505951.webp",
        "description": "Dokumentasi smartphone itel RS4 (MediaTek Helio G99, RAM 8GB) yang telah di-flash custom ROM AxionOS 2.6 AOSP dan dilakukan overclocking kernel untuk pengujian performa.",
        "metrics": "AxionOS 2.6 AOSP · Helio G99",
    },
    {
        "id": "pcb-inspection",
        "title": "Mounting Komponen & Cutting Panel PCB Audio",
        "category": "Hardware Assembly",
        "image": None,
        "description": "Aktivitas penempatan komponen (mounting) dan pemotongan (cutting) panel PCB audio di lini perakitan PT Panasonic Manufacturing Indonesia.",
        "metrics": "Lini Assembly Audio · SOP Pabrik",
    },
]


component Evidence():
    selected, set_selected = useState(None)

    def on_selected_change():
        if selected:
            document.body.style.setProperty("overflow", "hidden")
            def handle_key(e):
                if e.key == "Escape":
                    set_selected(None)
            window.addEventListener("keydown", handle_key)
            def cleanup():
                document.body.style.removeProperty("overflow")
                window.removeEventListener("keydown", handle_key)
            return cleanup
        else:
            document.body.style.removeProperty("overflow")
            def cleanup_noop():
                pass
            return cleanup_noop

    useEffect(on_selected_change, [selected])

    def open_modal(item):
        if item["image"]:
            set_selected(item)

    # Section mengalir normal. Tinggi dan "penguncian" diurus ScrollCards
    # lewat track + sticky, bukan oleh section.
    # Tanpa `px-6` di sini. Padding horizontal di section memotong 24px di
    # tiap sisi, sehingga stage kartu hanya 1386px dari 1434px yang tersedia;
    # kartu yang bergerak lalu terlihat "tertelan" tepi gelap di kiri dan
    # kanan. Padding teks diberikan di dalam, bukan di wadah yang bergerak.
    section(id="evidence", className="w-full border-t border-[#e6e5e0] text-left"):
        # Header TIDAK ditaruh di sini.
        #
        # ScrollCards menaruh judulnya sendiri di dalam stage yang menempel, dan
        # judul di sini akan jadi judul kedua -- terukur: dua "Dokumentasi &
        # Sertifikasi" di satu layar. Yang dipakai hanya yang di dalam stage,
        # karena hanya itu yang tetap terlihat selama animasi berjalan.
        #
        # Wadah kartu FULL-BLEED: kartu 90% x 1440 = 1296px akan terpotong ke
        # 1200 kalau dibatasi max-w-[1200px], dan celah antar kartu hilang.
        div(className="w-full"):
            ScrollCards(items=artifacts_data, on_open=open_modal)

        # Lightbox Modal
        if selected:
            div(
                className="fixed inset-0 z-50 bg-[#26251e]/85 backdrop-blur-sm flex items-center justify-center p-4 sm:p-8 cursor-zoom-out",
                onClick=lambda: set_selected(None),
            ):
                div(
                    className="relative max-w-[75vw] max-h-[75vh] sm:max-w-[55vw] sm:max-h-[65vh] flex items-center justify-center cursor-default",
                    onClick=lambda e: e.stopPropagation(),
                ):
                    button(
                        onClick=lambda: set_selected(None),
                        className="absolute top-3 right-3 z-10 h-8 px-3 rounded-[6px] bg-[#26251e]/80 hover:bg-[#26251e] text-white text-xs font-mono transition-colors border border-white/20 shadow-md cursor-pointer",
                    ): "Tutup (ESC)"
                    img(
                        src=selected["image"],
                        alt=selected["title"],
                        decoding="async",
                        className="max-h-[75vh] max-w-[75vw] sm:max-h-[65vh] sm:max-w-[55vw] w-auto h-auto object-contain rounded-[8px] shadow-2xl border border-white/10",
                    )

component Evidence():
    selected, set_selected = useState(None)
    copied_id, set_copied_id = useState(None)

    def open_modal(item):
        if item["image"]:
            set_selected(item)

    def copy_credential_id(cid):
        navigator.clipboard.writeText(cid)
        set_copied_id(cid)
        setTimeout(lambda: set_copied_id(None), 1800)

    section(id="evidence", className="py-24 px-6 max-w-[1200px] mx-auto border-t border-[#e6e5e0] text-left"):
        # Header
        div(className="max-w-3xl mb-12"):
            p(className="text-[11px] font-semibold font-mono tracking-[0.88px] uppercase text-[#807d72] mb-2"):
                "// DOKUMENTASI & SERTIFIKASI"
            h2(className="text-3xl sm:text-[36px] font-normal leading-[1.2] tracking-[-0.72px] text-[#26251e] mb-4"):
                "Dokumentasi Sertifikat & Perangkat"
            p(className="text-base font-normal leading-[1.5] text-[#5a5852]"):
                "Dokumentasi foto sertifikat resmi, server homelab lokal, dan hasil oprek perangkat yang pernah saya kerjakan."

        # Evidence Cards
        div(className="grid grid-cols-1 md:grid-cols-2 gap-6 mb-16"):
            for item in artifacts_data:
                div(
                    key=item["id"],
                    onClick=lambda it=item: open_modal(it),
                    className=f"p-6 sm:p-7 rounded-[12px] border border-[#e6e5e0] bg-white flex flex-col justify-between h-full hover:border-[#26251e] shadow-sm hover:shadow-lg transition-all duration-200 group select-none {'cursor-pointer' if item['image'] else 'cursor-default'}",
                ):
                    div():
                        h3(className="text-[19px] font-semibold leading-[1.3] text-[#26251e] group-hover:text-[#cc785c] transition-colors mb-2"):
                            item["title"]
                        p(className="text-sm font-normal leading-[1.55] text-[#5a5852] mb-5"):
                            item["description"]

                    if item["image"]:
                        div(className="w-full h-56 rounded-[8px] border border-[#e6e5e0] overflow-hidden relative bg-[#fafaf7]"):
                            img(
                                src=item["image"],
                                alt=item["title"],
                                className="w-full h-full object-cover group-hover:scale-[1.03] transition-transform duration-300",
                            )
                            div(className="absolute inset-0 bg-black/0 group-hover:bg-black/20 transition-colors flex items-center justify-center pointer-events-none"):
                                span(className="opacity-0 group-hover:opacity-100 transition-opacity text-xs font-mono text-white bg-[#26251e]/85 px-3 py-1.5 rounded-[6px] shadow-sm"):
                                    "Lihat Foto Asli"
                    else:
                        div(className="w-full h-56 rounded-[8px] border border-dashed border-[#cfcdc4] bg-[#fafaf7] flex flex-col items-center justify-center p-6 text-center"):
                            span(className="text-xs font-mono text-[#807d72] mb-2 select-none"):
                                "// REGULASI PABRIK"
                            p(className="text-sm font-mono text-[#26251e] mb-1.5"):
                                "Fotografi Tidak Diizinkan"
                            p(className="text-xs text-[#5a5852] max-w-xs leading-relaxed font-sans"):
                                "Dokumentasi foto di dalam lini manufaktur PT Panasonic Manufacturing Indonesia dilarang sesuai aturan kerahasiaan pabrik."

        # Certificates Table
        div(className="border-t border-[#e6e5e0] pt-12"):
            h3(className="text-xl sm:text-2xl font-normal tracking-[-0.5px] text-[#26251e] mb-6"):
                "Sertifikat & Pelatihan"

            div(className="w-full border-t border-[#e6e5e0] divide-y divide-[#e6e5e0]"):
                div(className="hidden md:grid md:grid-cols-12 gap-6 py-3.5 text-[11px] font-mono font-medium uppercase tracking-[0.88px] text-[#807d72] select-none"):
                    div(className="md:col-span-5"): "Nama Sertifikat"
                    div(className="md:col-span-3"): "Penerbit"
                    div(className="md:col-span-2"): "ID Kredensial"
                    div(className="md:col-span-2 text-right"): "Verifikasi"

                for cert in credentials_data:
                    div(
                        key=cert["id"],
                        className="py-5 grid grid-cols-1 md:grid-cols-12 gap-2.5 md:gap-6 items-baseline md:items-center hover:bg-black/[0.015] transition-colors group",
                    ):
                        div(className="md:col-span-5 space-y-1"):
                            span(className="text-[15px] sm:text-[16px] font-medium leading-[1.4] text-[#26251e] group-hover:text-[#cc785c] transition-colors block"):
                                cert["name"]
                            span(className="md:hidden text-xs font-mono text-[#807d72] block"):
                                f"{cert['issuer']} · {cert['year']}"

                        div(className="hidden md:block md:col-span-3"):
                            span(className="text-[13px] font-normal text-[#5a5852]"):
                                cert["issuer"]

                        div(className="md:col-span-2 flex items-center gap-2"):
                            button(
                                onClick=lambda cid=cert["id"]: copy_credential_id(cid),
                                className="text-[12px] font-mono text-[#26251e] hover:text-[#cc785c] transition-colors inline-flex items-center gap-1.5 group/btn text-left cursor-pointer",
                            ):
                                span(className="select-all"): cert["id"]
                                span(className="text-[10px] text-[#807d72] group-hover/btn:text-[#cc785c] transition-colors"):
                                    "[TERSALIN]" if copied_id == cert["id"] else "[SALIN]"

                        div(className="md:col-span-2 flex items-center justify-end"):
                            a(
                                href=cert["url"],
                                target="_blank" if cert["url"].startswith("http") else "_self",
                                rel="noreferrer" if cert["url"].startswith("http") else None,
                                className="inline-flex items-center text-[12px] font-mono text-[#cc785c] hover:text-[#a9583e] transition-colors",
                            ):
                                span(): "Verifikasi"
                                span(className="ml-1 text-[11px] font-mono"): "↗"

        # Lightbox Modal
        if selected:
            div(
                className="fixed inset-0 z-50 bg-[#26251e]/85 backdrop-blur-sm flex items-center justify-center p-4 sm:p-8 cursor-zoom-out",
                onClick=lambda: set_selected(None),
            ):
                div(
                    className="relative max-w-[75vw] max-h-[75vh] sm:max-w-[55vw] sm:max-h-[65vh] flex items-center justify-center cursor-default",
                    onClick=lambda e: e.stopPropagation(),
                ):
                    button(
                        onClick=lambda: set_selected(None),
                        className="absolute top-3 right-3 z-10 h-8 px-3 rounded-[6px] bg-[#26251e]/80 hover:bg-[#26251e] text-white text-xs font-mono transition-colors border border-white/20 shadow-md cursor-pointer",
                    ): "Tutup (ESC)"
                    img(
                        src=selected["image"],
                        alt=selected["title"],
                        className="max-h-[75vh] max-w-[75vw] sm:max-h-[65vh] sm:max-w-[55vw] w-auto h-auto object-contain rounded-[8px] shadow-2xl border border-white/10",
                    )

from "react" import useState, useEffect

artifacts_data = [
    {
        "id": "panasonic-cert",
        "title": "Sertifikat Fisik PKL Industri & Dicoding",
        "category": "Credentials",
        "image": "/images/PXL_20260403_113133217.jpg",
        "description": "Dokumentasi sertifikat fisik Praktik Kerja Lapangan di PT Panasonic Manufacturing Indonesia (Audio PCB Assembly, Nilai 94.3 / Grade A) dan sertifikat kelulusan back-end dari Dicoding Indonesia.",
        "metrics": "Nilai: 94.3 / 100 · 3 Bulan PKL",
    },
    {
        "id": "proxmox-telemetry",
        "title": "Homelab HPE ProLiant DL360 Gen9 & Pterodactyl",
        "category": "Infrastructure",
        "image": "/images/VID_20260514105929529.jpg",
        "description": "Dokumentasi live telemetry monitor Proxmox VE pada server fisik rack 1U HPE ProLiant DL360 Gen9 di kamar yang difungsikan sebagai node hosting Pterodactyl melalui tunnel WireGuard VPS (bypass CGNAT).",
        "metrics": "HPE DL360 Gen9 · WireGuard CGNAT Bypass · Pterodactyl",
    },
    {
        "id": "axion-rom",
        "title": "Custom ROM AxionOS & Overclocking itel RS4",
        "category": "Mobile & Firmware",
        "image": "/images/PXL_20260528_190505951.jpg",
        "description": "Dokumentasi smartphone itel RS4 (MediaTek Helio G99, RAM 8GB) yang telah di-flash custom ROM AxionOS 2.6 AOSP dan dilakukan overclocking kernel untuk pengujian performa.",
        "metrics": "AxionOS 2.6 AOSP · Helio G99",
    },
    {
        "id": "pcb-inspection",
        "title": "Mounting Komponen & Cutting Panel PCB Audio",
        "category": "Hardware Assembly",
        "image": None,
        "description": "Aktivitas penempatan komponen (mounting) dan pemotongan (cutting) panel PCB audio di lini perakitan PT Panasonic Manufacturing Indonesia.",
        "metrics": "Lini Assembly Audio · SOP Pabrik",
    },
]


component Evidence():
    selected, set_selected = useState(None)

    def on_selected_change():
        if selected:
            document.body.style.setProperty("overflow", "hidden")
            def handle_key(e):
                if e.key == "Escape":
                    set_selected(None)
            window.addEventListener("keydown", handle_key)
            def cleanup():
                document.body.style.removeProperty("overflow")
                window.removeEventListener("keydown", handle_key)
            return cleanup
        else:
            document.body.style.removeProperty("overflow")
            def cleanup_noop():
                pass
            return cleanup_noop

    useEffect(on_selected_change, [selected])

    def open_modal(item):
        if item["image"]:
            set_selected(item)

    section(id="evidence", className="py-24 px-6 max-w-[1200px] mx-auto border-t border-[#e6e5e0] text-left"):
        # Header
        div(className="max-w-3xl mb-12"):
            p(className="text-[11px] font-semibold font-mono tracking-[0.88px] uppercase text-[#6c6a64] mb-2"):
                "// ARSIP & KREDENSIAL"
            h2(className="text-3xl sm:text-[36px] font-normal leading-[1.2] tracking-[-0.72px] text-[#26251e] mb-4"):
                "Dokumentasi & Sertifikasi"
            p(className="text-base font-normal leading-[1.5] text-[#5a5852]"):
                "Kredensial resmi, homelab, dan hasil oprek perangkat yang pernah saya kerjakan."

        # Evidence Cards
        div(className="grid grid-cols-1 md:grid-cols-2 gap-6 mb-16"):
            for item in artifacts_data:
                div(
                    key=item["id"],
                    onClick=lambda it=item: open_modal(it),
                    onKeyDown=lambda e, it=item: open_modal(it) if (e.key == "Enter" or e.key == " ") else None,
                    role="button" if item["image"] else None,
                    tabIndex=0 if item["image"] else None,
                    aria_label=f"Lihat foto {item['title']}" if item["image"] else None,
                    className=f"p-6 sm:p-7 rounded-[12px] border border-[#e6e5e0] bg-white flex flex-col justify-between h-full hover:border-[#26251e] shadow-sm hover:shadow-lg transition-all duration-200 group select-none {'cursor-pointer focus:outline-none focus:ring-2 focus:ring-[#cc785c]' if item['image'] else 'cursor-default'}",
                ):
                    div():
                        h3(className="text-[19px] font-semibold leading-[1.3] text-[#26251e] group-hover:text-[#a9583e] transition-colors mb-2"):
                            item["title"]
                        p(className="text-sm font-normal leading-[1.55] text-[#5a5852] mb-5"):
                            item["description"]

                    if item["image"]:
                        div(className="w-full h-56 rounded-[8px] border border-[#e6e5e0] overflow-hidden relative bg-[#fafaf7]"):
                            img(
                                src=item["image"],
                                alt=item["title"],
                                loading="lazy",
                                decoding="async",
                                className="w-full h-full object-cover group-hover:scale-[1.03] transition-transform duration-300",
                            )
                            div(className="absolute inset-0 bg-black/0 group-hover:bg-black/20 transition-colors flex items-center justify-center pointer-events-none"):
                                span(className="opacity-0 group-hover:opacity-100 transition-opacity text-xs font-mono text-white bg-[#26251e]/85 px-3 py-1.5 rounded-[6px] shadow-sm"):
                                    "Lihat Foto Asli"
                    else:
                        div(className="w-full h-56 rounded-[8px] border border-dashed border-[#cfcdc4] bg-[#fafaf7] flex flex-col items-center justify-center p-6 text-center"):
                            span(className="text-xs font-mono text-[#6c6a64] mb-2 select-none"):
                                "// REGULASI PABRIK"
                            p(className="text-sm font-mono text-[#26251e] mb-1.5"):
                                "Fotografi Tidak Diizinkan"
                            p(className="text-xs text-[#5a5852] max-w-xs leading-relaxed font-sans"):
                                "Dokumentasi foto di dalam lini manufaktur PT Panasonic Manufacturing Indonesia dilarang sesuai aturan kerahasiaan pabrik."

        # Lightbox Modal
        if selected:
            div(
                className="fixed inset-0 z-50 bg-[#26251e]/85 backdrop-blur-sm flex items-center justify-center p-4 sm:p-8 cursor-zoom-out",
                onClick=lambda: set_selected(None),
            ):
                div(
                    className="relative max-w-[75vw] max-h-[75vh] sm:max-w-[55vw] sm:max-h-[65vh] flex items-center justify-center cursor-default",
                    onClick=lambda e: e.stopPropagation(),
                ):
                    button(
                        onClick=lambda: set_selected(None),
                        className="absolute top-3 right-3 z-10 h-8 px-3 rounded-[6px] bg-[#26251e]/80 hover:bg-[#26251e] text-white text-xs font-mono transition-colors border border-white/20 shadow-md cursor-pointer",
                    ): "Tutup (ESC)"
                    img(
                        src=selected["image"],
                        alt=selected["title"],
                        decoding="async",
                        className="max-h-[75vh] max-w-[75vw] sm:max-h-[65vh] sm:max-w-[55vw] w-auto h-auto object-contain rounded-[8px] shadow-2xl border border-white/10",
                    )

component Projects():
    section(id="projects", className="py-24 px-6 max-w-[1200px] mx-auto border-t border-[#e6e5e0] text-left"):
        SectionHeading(
            kicker="// REPOSITORI & KARYA",
            title="Proyek & Karya",
            lede="Ekosistem HydraScript yang saya rancang dan kembangkan, ditambah platform produksi yang berjalan untuk pengguna nyata.",
            align="left",
        )

        div(className="grid grid-cols-1 md:grid-cols-2 gap-6"):
            for prj in projects_data:
                a(
                    key=prj["id"],
                    href=prj["url"],
                    target="_blank",
                    rel="noreferrer",
                    data_reveal="scale",
                    className="group flex flex-col p-7 sm:p-8 rounded-[12px] bg-white border border-[#e6e5e0] hover:border-[#26251e] shadow-sm hover:shadow-xl transition-all duration-300 relative overflow-hidden",
                ):
                    div(className="absolute top-0 left-0 right-0 h-[2px] bg-transparent group-hover:bg-[#cc785c] transition-colors duration-300"): ""

                    div(className="flex items-center justify-between mb-6"):
                        span(className="text-xs font-mono font-medium text-[#6c6a64] tracking-wider uppercase"):
                            f"// {prj['category']}"
                        div(className="w-8 h-8 rounded-full border border-[#e6e5e0] group-hover:border-[#26251e] group-hover:bg-[#26251e] flex items-center justify-center transition-all duration-300"):
                            span(className="text-xs font-mono text-[#6c6a64] group-hover:text-white transition-colors"):
                                "↗"

                    h3(className="text-[20px] font-semibold leading-[1.3] text-[#26251e] group-hover:text-[#a9583e] transition-colors mb-3 tracking-tight"):
                        prj["title"]

                    p(className="text-[13.5px] font-normal leading-[1.65] text-[#5a5852] mb-6"):
                        prj["description"]

                    div(className="mt-auto pt-5 border-t border-[#efeee8] flex items-center justify-between"):
                        span(className="text-[11px] font-mono uppercase tracking-[0.88px] text-[#6c6a64]"):
                            prj["status"]
                        span(className="text-[12px] font-mono text-[#a9583e] group-hover:text-[#a9583e] transition-colors"):
                            prj["linkLabel"]

# [xihanzu-NR]

component About():
    section(id="about", className="py-24 px-6 max-w-[1200px] mx-auto border-t border-[#e6e5e0] text-left"):
        div(className="max-w-3xl mb-12"):
            p(className="text-[11px] font-semibold font-mono tracking-[0.88px] uppercase text-[#6c6a64] mb-2"):
                "// TENTANG SAYA"
            h2(className="text-3xl sm:text-[36px] font-normal leading-[1.2] tracking-[-0.72px] text-[#26251e] mb-4"):
                span(className="block sm:inline"): "Reyhan Akhtar Afriansyah"
                span(className="hidden sm:inline text-[#6c6a64] font-light"): " — "
                span(className="block sm:inline text-base sm:text-xl md:text-[28px] text-[#6c6a64] font-mono sm:font-sans mt-1 sm:mt-0"):
                    "Developer & Systems Enthusiast"

        div(className="pt-10 border-t border-[#e6e5e0]"):
            div(className="grid grid-cols-1 lg:grid-cols-12 gap-8"):
                div(className="lg:col-span-5 space-y-3"):
                    div(className="space-y-2 text-xs font-mono"):
                        div(className="flex items-baseline gap-3"):
                            span(className="text-[#6c6a64] w-24 shrink-0"): "Pendidikan"
                            span(className="text-[#26251e]"): "SMK Ma'arif 1 Kroya"
                        div(className="flex items-baseline gap-3"):
                            span(className="text-[#6c6a64] w-24 shrink-0"): "Jurusan"
                            span(className="text-[#26251e]"): "Teknik Audio Video (TAV)"
                        div(className="flex items-baseline gap-3"):
                            span(className="text-[#6c6a64] w-24 shrink-0"): "Usia"
                            span(className="text-[#26251e]"): "17 tahun"
                        div(className="flex items-baseline gap-3"):
                            span(className="text-[#6c6a64] w-24 shrink-0"): "Fokus"
                            span(className="text-[#a9583e] font-medium"): "Web, Systems & AI"
                        div(className="flex items-baseline gap-3"):
                            span(className="text-[#6c6a64] w-24 shrink-0"): "Daily OS"
                            span(className="text-[#26251e]"): "Void Linux (runit)"

                div(className="lg:col-span-7 text-[15px] sm:text-base font-normal leading-[1.7] text-[#5a5852]"):
                    p():
                        "Latar SMK jurusan Teknik Audio Video (TAV) bikin saya nyaman kerja di level perangkat keras, lanjut ke mengelola server Linux mandiri di rumah, sampai membuat website dan melatih model kecerdasan buatan (AI). Riwayat pengalaman dan sertifikat bisa dilihat di bawah."

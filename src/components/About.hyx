# [xihanzu-NR]

component About():
    section(id="about", className="py-24 px-6 max-w-[1200px] mx-auto text-left"):
        div(className="max-w-3xl mb-12"):
            p(className="text-[11px] font-semibold font-mono tracking-[0.88px] uppercase text-[#807d72] mb-2"):
                "// TENTANG SAYA"
            h2(className="text-2xl sm:text-3xl md:text-[40px] font-normal leading-[1.2] tracking-[-0.6px] sm:tracking-[-1px] text-[#26251e] mb-3"):
                span(className="block sm:inline"): "Reyhan Akhtar Afriansyah"
                span(className="hidden sm:inline text-[#807d72] font-light"): " — "
                span(className="block sm:inline text-base sm:text-xl md:text-[28px] text-[#807d72] font-mono sm:font-sans mt-1 sm:mt-0"):
                    "Developer & Systems Enthusiast"

        div(className="pt-10 border-t border-[#e6e5e0]"):
            div(className="grid grid-cols-1 lg:grid-cols-12 gap-8"):
                div(className="lg:col-span-5 space-y-3"):
                    div(className="space-y-2 text-xs font-mono"):
                        div(className="flex items-baseline gap-3"):
                            span(className="text-[#807d72] w-24 shrink-0"): "Fokus"
                            span(className="text-[#f54e00] font-medium"): "Web, Systems & AI"
                        div(className="flex items-baseline gap-3"):
                            span(className="text-[#807d72] w-24 shrink-0"): "Daily OS"
                            span(className="text-[#26251e]"): "Void Linux (runit)"

                div(className="lg:col-span-7 text-[15px] sm:text-base font-normal leading-[1.7] text-[#5a5852]"):
                    p():
                        "Saya tertarik mengulik teknologi dari level perangkat keras, mengelola server Linux mandiri di rumah, sampai membuat website dan melatih model kecerdasan buatan (AI). Seluruh riwayat pengalaman dan sertifikat bisa dilihat di bawah."

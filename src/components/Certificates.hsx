# [xihanzu-NR]
from "react" import useState

credentials_data = [
    {
        "name": "Sertifikat Praktik Kerja Lapangan (PKL) – Audio PCB Assembly",
        "issuer": "PT Panasonic Manufacturing Indonesia",
        "year": "2026",
        "id": "561/AD-PERS/I/2026",
        "url": "#evidence",
        "score": "Nilai 94.3 / Grade A",
    },
    {
        "name": "Belajar Back-End Pemula dengan JavaScript",
        "issuer": "Dicoding Indonesia",
        "year": "2026",
        "id": "98XWO65KLXM3",
        "url": "https://www.dicoding.com/certificates/98XWO65KLXM3",
        "score": "Tersertifikasi",
    },
    {
        "name": "Belajar Dasar AI",
        "issuer": "Dicoding Indonesia",
        "year": "2026",
        "id": "RVZKO4110ZD5",
        "url": "https://www.dicoding.com/certificates/RVZKO4110ZD5",
        "score": "Tersertifikasi",
    },
    {
        "name": "Belajar Dasar Pemrograman JavaScript",
        "issuer": "Dicoding Indonesia",
        "year": "2026",
        "id": "DICODING-JS-2026",
        "url": "https://www.dicoding.com/certificates/98XWO65KLXM3",
        "score": "Tersertifikasi",
    },
]

component Certificates():
    copied_id, set_copied_id = useState(None)

    def copy_credential_id(cid):
        navigator.clipboard.writeText(cid)
        set_copied_id(cid)
        setTimeout(lambda: set_copied_id(None), 1800)

    section(id="certificates", className="py-24 px-6 max-w-[1200px] mx-auto border-t border-[#e6e5e0] text-left"):
        # Header (Clean, concise, zero redundancy)
        div(className="max-w-3xl mb-12"):
            p(className="text-[11px] font-semibold font-mono tracking-[0.88px] uppercase text-[#f54e00] mb-2"):
                "// SERTIFIKASI"
            h2(className="text-3xl sm:text-[36px] font-normal leading-[1.2] tracking-[-0.72px] text-[#26251e] mb-3"):
                "Sertifikat & Pelatihan"
            p(className="text-base font-normal leading-[1.6] text-[#5a5852]"):
                "Sertifikat PKL industri dan kelulusan kelas pelatihan online yang telah saya selesaikan."

        # Cardless Ledger Table
        div(className="w-full border-t border-[#e6e5e0] divide-y divide-[#e6e5e0]"):
            # Header Row
            div(className="hidden md:grid md:grid-cols-12 gap-6 py-3.5 text-[11px] font-mono font-medium uppercase tracking-[0.88px] text-[#807d72] select-none"):
                div(className="md:col-span-5"): "Nama Sertifikat"
                div(className="md:col-span-3"): "Penerbit"
                div(className="md:col-span-1"): "Tahun"
                div(className="md:col-span-2"): "ID Kredensial"
                div(className="md:col-span-1 text-right"): "Verifikasi"

            # Data Rows
            for cert in credentials_data:
                div(
                    key=cert["id"],
                    className="py-5 grid grid-cols-1 md:grid-cols-12 gap-2.5 md:gap-6 items-baseline md:items-center hover:bg-black/[0.015] transition-colors group",
                ):
                    # Name & Mobile Meta
                    div(className="md:col-span-5 space-y-1"):
                        span(className="text-[15px] sm:text-[16px] font-medium leading-[1.4] text-[#26251e] group-hover:text-[#f54e00] transition-colors block"):
                            cert["name"]
                        span(className="md:hidden text-xs font-mono text-[#807d72] block"):
                            f"{cert['issuer']} · {cert['year']}"

                    # Issuer (Desktop)
                    div(className="hidden md:block md:col-span-3"):
                        span(className="text-[13px] font-normal text-[#5a5852]"):
                            cert["issuer"]

                    # Year (Desktop)
                    div(className="hidden md:block md:col-span-1"):
                        span(className="text-[13px] font-mono text-[#807d72]"):
                            cert["year"]

                    # ID with Copy
                    div(className="md:col-span-2 flex items-center justify-between md:justify-start gap-2"):
                        span(className="md:hidden text-xs font-mono text-[#807d72]"): "ID:"
                        button(
                            onClick=lambda cid=cert["id"]: copy_credential_id(cid),
                            className="text-[12px] font-mono text-[#26251e] hover:text-[#f54e00] transition-colors inline-flex items-center gap-1.5 group/btn text-left cursor-pointer",
                        ):
                            span(className="select-all"): cert["id"]
                            span(className="text-[10px] text-[#807d72] group-hover/btn:text-[#f54e00] transition-colors"):
                                "[TERSALIN]" if copied_id == cert["id"] else "[SALIN]"

                    # Verification Action
                    div(className="md:col-span-1 flex items-center justify-end pt-2 md:pt-0 border-t md:border-t-0 border-[#efeee8]"):
                        a(
                            href=cert["url"],
                            target="_blank" if cert["url"].startswith("http") else "_self",
                            rel="noreferrer" if cert["url"].startswith("http") else None,
                            className="inline-flex items-center text-[12px] font-mono text-[#f54e00] hover:text-[#d04200] transition-colors",
                        ):
                            span(): "Verifikasi"
                            span(className="ml-1 text-[11px] font-mono"): "↗"

# [xihanzu-NR]
from "react" import useState, useEffect, useRef
from "./ClickSpark.hyx" import ClickSpark
from "../utils/staggeredMenuEngine.hys" import init_menu_gsap, play_open_menu, play_close_menu, animate_hamburger

default_items = [
    {"label": "About", "link": "#about", "num": "01"},
    {"label": "Projects", "link": "#projects", "num": "02"},
    {"label": "Experience", "link": "#experience", "num": "03"},
    {"label": "Evidence", "link": "#evidence", "num": "04"},
    {"label": "Contact", "link": "#contact", "num": "05"},
]

default_socials = [
    {"label": "GitHub", "link": "https://github.com/hanxthvy"},
    {"label": "Email", "link": "mailto:contact@hanz.dev"},
    {"label": "WhatsApp", "link": "https://wa.me/6281234567890"},
]

prelayer_colors = ["#e6e5e0", "#cfcdc4", "#26251e"]

component Navbar():
    scroll_progress, set_scroll_progress = useState(0)
    is_scrolled, set_is_scrolled = useState(False)
    is_open, set_is_open = useState(False)

    panel_ref = useRef(None)
    pre_container_ref = useRef(None)
    bar1_ref = useRef(None)
    bar2_ref = useRef(None)
    bar3_ref = useRef(None)

    def handle_scroll():
        total_scroll = document.documentElement.scrollHeight - window.innerHeight
        if total_scroll > 0:
            pct = (window.scrollY / total_scroll) * 100
            clamped = 0 if pct < 0 else (100 if pct > 100 else pct)
            set_scroll_progress(clamped)
        set_is_scrolled(window.scrollY > 20)

    useEffect(lambda: (
        window.addEventListener("scroll", handle_scroll, {"passive": True}),
        lambda: window.removeEventListener("scroll", handle_scroll)
    )[-1], [])

    def init_effect():
        panel = panel_ref.current
        pre_container = pre_container_ref.current
        layers = pre_container.children if pre_container else []
        init_menu_gsap(panel, layers, bar1_ref.current, bar2_ref.current, bar3_ref.current)
        return lambda: None

    useEffect(init_effect, [])

    def open_menu():
        panel = panel_ref.current
        pre_container = pre_container_ref.current
        layers = pre_container.children if pre_container else []
        set_is_open(True)
        animate_hamburger(bar1_ref.current, bar2_ref.current, bar3_ref.current, True)
        play_open_menu(panel, layers)

    def close_menu():
        panel = panel_ref.current
        pre_container = pre_container_ref.current
        layers = pre_container.children if pre_container else []
        set_is_open(False)
        animate_hamburger(bar1_ref.current, bar2_ref.current, bar3_ref.current, False)
        play_close_menu(panel, layers)

    def toggle_menu():
        if is_open:
            close_menu()
        else:
            open_menu()

    div():
        header(
            className=f"fixed top-0 left-0 right-0 z-40 transition-all duration-200 {'bg-[#f7f7f4]/95 backdrop-blur-md border-b border-[#e6e5e0] shadow-sm' if is_scrolled else 'bg-[#f7f7f4]/80 backdrop-blur-sm border-b border-transparent'}",
        ):
            div(className="absolute top-0 left-0 right-0 h-[2px] bg-[#e6e5e0]"):
                div(
                    className="h-full bg-[#f54e00] will-change-[width] transition-[width] duration-75",
                    style={"width": f"{scroll_progress}%"},
                )

            div(className="max-w-[1200px] mx-auto px-6 h-16 flex items-center justify-between"):
                div(className="flex items-center gap-3"):
                    a(href="#", className="text-[17px] sm:text-[18px] font-semibold tracking-tight text-[#26251e] hover:text-[#f54e00] transition-colors"):
                        "Reyhan Akhtar"
                    span(className="hidden md:inline-block text-xs font-mono text-[#807d72]"):
                        "// DEVELOPER"

                nav(className="hidden md:flex items-center gap-6 lg:gap-8"):
                    a(href="#about", className="text-[13px] font-mono text-[#5a5852] hover:text-[#26251e] transition-colors"):
                        "About"
                    a(href="#projects", className="text-[13px] font-mono text-[#5a5852] hover:text-[#26251e] transition-colors"):
                        "Projects"
                    a(href="#experience", className="text-[13px] font-mono text-[#5a5852] hover:text-[#26251e] transition-colors"):
                        "Experience"
                    a(href="#evidence", className="text-[13px] font-mono text-[#5a5852] hover:text-[#26251e] transition-colors"):
                        "Evidence"
                    a(href="#contact", className="text-[13px] font-mono text-[#5a5852] hover:text-[#26251e] transition-colors"):
                        "Contact"

                button(
                    onClick=toggle_menu,
                    className="w-10 h-10 p-2 inline-flex flex-col justify-center items-center gap-[5px] bg-transparent hover:bg-black/5 active:bg-black/10 rounded-[6px] transition-colors cursor-pointer select-none relative z-50",
                    aria_label="Toggle Menu",
                ):
                    span(ref=bar1_ref, className="w-5 h-[1.8px] bg-[#26251e] rounded-full transition-transform origin-center")
                    span(ref=bar2_ref, className="w-5 h-[1.8px] bg-[#26251e] rounded-full transition-transform origin-center")
                    span(ref=bar3_ref, className="w-5 h-[1.8px] bg-[#26251e] rounded-full transition-transform origin-center")

        div(
            ref=pre_container_ref,
            className="fixed top-0 right-0 bottom-0 pointer-events-none z-[60] w-full sm:w-[420px] h-full",
            aria_hidden=True,
        ):
            for c in prelayer_colors:
                div(
                    key=c,
                    className="absolute top-0 right-0 h-full w-full",
                    style={"backgroundColor": c},
                )

        if is_open:
            div(
                className="fixed inset-0 bg-black/40 backdrop-blur-[2px] z-[55] transition-opacity cursor-pointer",
                onClick=close_menu,
            )

        aside(
            ref=panel_ref,
            className="fixed top-0 right-0 bottom-0 w-full sm:w-[420px] h-full bg-[#f7f7f4] border-l border-[#e6e5e0] flex flex-col justify-between p-8 sm:p-12 overflow-y-auto z-[65] shadow-2xl text-left",
            aria_hidden=not is_open,
        ):
            div(className="flex items-center justify-between pb-8 border-b border-[#e6e5e0]"):
                span(className="text-xs font-mono text-[#807d72] tracking-[0.88px] uppercase"):
                    "// MENU NAVIGASI"
                button(
                    onClick=close_menu,
                    className="text-xs font-mono text-[#807d72] hover:text-[#f54e00] transition-colors cursor-pointer",
                ):
                    "[TUTUP]"

            ul(className="flex flex-col gap-6 my-auto py-8 list-none"):
                for it in default_items:
                    li(key=it["link"], className="overflow-hidden leading-none"):
                        a(
                            href=it["link"],
                            onClick=close_menu,
                            className="group flex items-baseline justify-between text-3xl sm:text-4xl font-normal text-[#26251e] hover:text-[#f54e00] transition-colors tracking-tight",
                        ):
                            span(className="sm-panel-itemLabel inline-block"):
                                it["label"]
                            span(className="sm-panel-num text-xs font-mono text-[#f54e00] opacity-0 transition-opacity"):
                                it["num"]

            div(className="pt-8 border-t border-[#e6e5e0] space-y-3"):
                p(className="text-[11px] font-mono uppercase tracking-[0.88px] text-[#807d72]"):
                    "// KONTAK & TAUTAN"
                div(className="flex flex-wrap gap-4"):
                    for s in default_socials:
                        a(
                            key=s["label"],
                            href=s["link"],
                            target="_blank",
                            rel="noreferrer",
                            className="sm-socials-link text-xs font-mono text-[#26251e] hover:text-[#f54e00] transition-colors inline-flex items-center gap-1",
                        ):
                            span(): s["label"]
                            span(className="text-[#f54e00] text-[10px]"): "↗"

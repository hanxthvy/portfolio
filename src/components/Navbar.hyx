# [xihanzu-NR]
from "react" import useState, useEffect, useRef
from "./ClickSpark.hyx" import ClickSpark
from "../utils/staggeredMenuEngine.hys" import init_menu_gsap, play_open_menu, play_close_menu, animate_hamburger, trim_colors
from "../utils/scrollEngine" import on_scroll
from "../utils/sweepEngine.hys" import pick_corner

default_items = [
    {"label": "About", "link": "#about", "num": "01"},
    {"label": "Projects", "link": "#projects", "num": "02"},
    {"label": "Experience", "link": "#experience", "num": "03"},
    {"label": "Evidence", "link": "#evidence", "num": "04"},
    {"label": "Contact", "link": "#contact", "num": "05"},
]

default_socials = [
    {"label": "GitHub", "link": "https://github.com/hanxthvy"},
    {"label": "Instagram", "link": "https://instagram.com/hanxthvy"},
    {"label": "TikTok", "link": "https://www.tiktok.com/@homexihanzu"},
    {"label": "Email", "link": "mailto:contact@hanz.dev"},
]

# Tiga warna dimasukkan, engine memangkas elemen tengahnya jadi dua --
# persis seperti `colors.slice(0,4)` lalu `splice(mid,1)` di sumber aslinya.
prelayer_colors = ["#e6e5e0", "#cfcdc4", "#26251e"]

component Navbar():
    # Catatan: lebar progress bar dan translasi navbar ditulis langsung ke style
    # lewat ref, bukan lewat state. Sebelumnya setState dipanggil tiap event
    # scroll sehingga React merender ulang navbar terus-menerus.
    progress_ref = useRef(None)
    # Posisi absolut #about, dihitung sekali (-1 = belum diukur).
    posisi_about_ref = useRef(-1.0)
    shell_ref = useRef(None)
    visible_ref = useRef(False)
    is_visible, set_is_visible = useState(False)
    is_open, set_is_open = useState(False)
    sweep_counter = useRef({"n": 0})

    panel_ref = useRef(None)
    pre_container_ref = useRef(None)
    bar1_ref = useRef(None)
    bar2_ref = useRef(None)
    bar3_ref = useRef(None)

    def init_theme():
        # Dark adalah satu-satunya tema.
        #
        # Toggle terang/gelap dihapus: dua tema berarti dua kali kerja untuk
        # setiap warna di setiap komponen, dan yang terang tidak pernah
        # dirawat sebaik yang gelap. Kelas `dark` selalu dipasang, dan
        # localStorage tidak dibaca lagi -- preferensi lama diabaikan dengan
        # sengaja supaya pengunjung yang pernah memilih "light" tidak
        # terjebak di tema yang sudah tidak ada.
        document.documentElement.classList.add("dark")
        try:
            localStorage.removeItem("theme")
        except:
            pass
        return lambda: None

    useEffect(init_theme, [])

    def handle_scroll(frame):
        # Progress bar: cukup tulis width, tanpa render ulang.
        if progress_ref.current:
            Object.assign(progress_ref.current.style, {"width": f"{frame.progress * 100:.3f}%"})

        # Catatan: assignment di dalam if/else (.hyx) ter-scope pada cabangnya,
        # jadi nilainya dihitung sebagai satu ekspresi agar tetap terlihat di
        # bawah. get("about", None) dipakai supaya tidak perlu cabang.
        # `getBoundingClientRect()` di sini dibaca SETIAP frame scroll, dan
        # karena `handle_scroll` jalan sesudah ScrollCards menulis transform,
        # pembacaan itu memaksa browser menghitung ulang layout tepat di
        # tengah animasi kartu. Di desktop (frame lebih banyak per detik)
        # akibatnya terlihat sebagai glitch.
        #
        # Yang dibutuhkan cuma "apakah #about sudah lewat 80px dari atas",
        # dan itu tidak perlu diukur ulang selama ukuran halaman tidak
        # berubah. Posisi absolutnya dihitung sekali lalu disimpan; per frame
        # tinggal dibandingkan dengan `frame.y` yang sudah tersedia.
        pos_about = posisi_about_ref.current
        if pos_about < 0:
            about_el = document.getElementById("about")
            if about_el:
                pos_about = about_el.getBoundingClientRect().top + window.scrollY
                Object.assign(posisi_about_ref, {"current": pos_about})
        want = (frame.y + 80 >= pos_about) if pos_about >= 0 else (frame.y >= (window.innerHeight * 0.7))

        # Translasi shell ditulis per frame supaya munculnya benar-benar
        # mengikuti gulir, bukan melompat sekali.
        if shell_ref.current:
            travel = 0.0 if want else -130.0
            Object.assign(shell_ref.current.style, {
                "transform": f"translate3d(0, {travel:.1f}%, 0)",
                "opacity": "1" if want else "0",
            })

        if want != visible_ref.current:
            Object.assign(visible_ref, {"current": want})
            set_is_visible(want)

    def reset_ukur(frame=None):
        # Posisi #about berubah kalau layar berubah ukuran (atau isi di
        # atasnya berubah tinggi), jadi cache-nya dibuang.
        Object.assign(posisi_about_ref, {"current": -1.0})

    def scroll_effect():
        batal = on_scroll(handle_scroll)
        window.addEventListener("resize", reset_ukur, {"passive": True})

        def bersih():
            reset_ukur()
            if batal:
                batal()
            window.removeEventListener("resize", reset_ukur)

        return bersih

    useEffect(scroll_effect, [])

    def init_effect():
        panel = panel_ref.current
        pre_container = pre_container_ref.current
        layers = pre_container.children if pre_container else []
        init_menu_gsap(panel, layers, bar1_ref.current, bar2_ref.current, bar3_ref.current)
        return lambda: None

    useEffect(init_effect, [])

    def open_menu():
        panel = panel_ref.current
        pre_container = pre_container_ref.current
        layers = pre_container.children if pre_container else []
        set_is_open(True)
        animate_hamburger(bar1_ref.current, bar2_ref.current, bar3_ref.current, True)
        play_open_menu(panel, layers)

    def close_menu():
        panel = panel_ref.current
        pre_container = pre_container_ref.current
        layers = pre_container.children if pre_container else []
        set_is_open(False)
        animate_hamburger(bar1_ref.current, bar2_ref.current, bar3_ref.current, False)
        play_close_menu(panel, layers)

    def toggle_menu():
        if is_open:
            close_menu()
        else:
            open_menu()

    def scroll_to_target(e, target):
        if e and e.preventDefault:
            e.preventDefault()
        close_menu()

        # Transisi dulu, baru pindah section.
        #
        # Kalau `window.__hydraSweep` tidak ada (misalnya JS komponen itu belum
        # ter-mount), jangan tahan navigasi: pengguna tetap harus sampai ke
        # section yang dituju. Sapuan itu hiasan, bukan syarat.
        clean_id = "top" if (target == "top" or not target or target == "#") else target.replace("#", "")
        sweep = getattr(window, "__hydraSweep", None)
        if sweep:
            idx = sweep_counter["n"]
            sweep_counter["n"] = idx + 1
            sweep(clean_id, pick_corner(clean_id, idx))
        else:
            # Fallback tanpa sapuan: lompat langsung, bukan smooth.
            # Scroll halus bertabrakan dengan transisi lingkaran -- pengguna
            # melihat halaman meluncur sambil tertutup separuh, dan itu terasa
            # seperti dua animasi yang tidak sepakat.
            if clean_id == "top":
                window.scrollTo({"top": 0, "behavior": "auto"})
            else:
                el = document.getElementById(clean_id)
                if el:
                    el.scrollIntoView({"behavior": "auto"})

    div():
        # Shell dipisah dari <header> supaya navbar bisa dianimasikan dengan
        # transform (murah, jalan di compositor) alih-alih clip-path + opacity
        # yang memaksa repaint seluruh bar.
        div(
            ref=shell_ref,
            className="fixed top-0 left-0 right-0 z-40 bg-[#f7f7f4]/95 backdrop-blur-md border-b border-[#e6e5e0] shadow-sm select-none will-change-transform",
            style={
                "transform": "translate3d(0, 0%, 0)" if is_visible else "translate3d(0, -130%, 0)",
                "opacity": "1" if is_visible else "0",
                "pointerEvents": "auto" if is_visible else "none",
                "transition": "transform 0.28s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.2s ease-out",
            },
        ):
            header():
                div(className="absolute top-0 left-0 right-0 h-[2px] bg-[#e6e5e0]"):
                    div(
                        ref=progress_ref,
                        className="h-full bg-[#cc785c] will-change-[width]",
                        style={"width": "0%"},
                    )

            div(className="max-w-[1200px] mx-auto px-6 h-16 flex items-center justify-between"):
                div(className="flex items-center gap-3"):
                    a(
                        href="#",
                        onClick=lambda e: scroll_to_target(e, "top"),
                        className="text-[17px] sm:text-[18px] font-semibold tracking-tight text-[#26251e] hover:text-[#a9583e] transition-colors cursor-pointer",
                    ):
                        "Reyhan Akhtar"
                    span(className="hidden md:inline-block text-xs font-mono text-[#6c6a64]"):
                        "// DEVELOPER"

                div(className="flex items-center gap-3 sm:gap-6"):
                    nav(className="hidden md:flex items-center gap-6 lg:gap-8"):
                        a(
                            href="#about",
                            onClick=lambda e: scroll_to_target(e, "about"),
                            className="text-[13px] font-mono text-[#5a5852] hover:text-[#26251e] transition-colors cursor-pointer",
                        ):
                            "About"
                        a(
                            href="#projects",
                            onClick=lambda e: scroll_to_target(e, "projects"),
                            className="text-[13px] font-mono text-[#5a5852] hover:text-[#26251e] transition-colors cursor-pointer",
                        ):
                            "Projects"
                        a(
                            href="#experience",
                            onClick=lambda e: scroll_to_target(e, "experience"),
                            className="text-[13px] font-mono text-[#5a5852] hover:text-[#26251e] transition-colors cursor-pointer",
                        ):
                            "Experience"
                        a(
                            href="#evidence",
                            onClick=lambda e: scroll_to_target(e, "evidence"),
                            className="text-[13px] font-mono text-[#5a5852] hover:text-[#26251e] transition-colors cursor-pointer",
                        ):
                            "Evidence"
                        a(
                            href="#contact",
                            onClick=lambda e: scroll_to_target(e, "contact"),
                            className="text-[13px] font-mono text-[#5a5852] hover:text-[#26251e] transition-colors cursor-pointer",
                        ):
                            "Contact"


                    button(
                        onClick=toggle_menu,
                        className="md:hidden w-10 h-10 p-2 inline-flex flex-col justify-center items-center gap-[5px] bg-transparent hover:bg-black/5 active:bg-black/10 rounded-[6px] transition-colors cursor-pointer select-none relative z-50",
                        aria_label="Toggle Menu",
                    ):
                        span(ref=bar1_ref, className="w-5 h-[1.8px] bg-[#26251e] rounded-full transition-transform origin-center")
                        span(ref=bar2_ref, className="w-5 h-[1.8px] bg-[#26251e] rounded-full transition-transform origin-center")
                        span(ref=bar3_ref, className="w-5 h-[1.8px] bg-[#26251e] rounded-full transition-transform origin-center")

        div(
            ref=pre_container_ref,
            className="md:hidden fixed top-0 right-0 bottom-0 pointer-events-none z-[60] w-full sm:w-[420px] h-full",
            aria_hidden=True,
        ):
            for c in trim_colors(prelayer_colors):
                div(
                    key=c,
                    className="sm-prelayer absolute top-0 right-0 h-full w-full",
                    style={"backgroundColor": c},
                )

        if is_open:
            div(
                className="md:hidden fixed inset-0 bg-black/40 backdrop-blur-[2px] z-[55] transition-opacity cursor-pointer",
                onClick=close_menu,
            )

        aside(
            ref=panel_ref,
            className="sm-panel md:hidden fixed top-0 right-0 bottom-0 w-full sm:w-[420px] h-full bg-[#f7f7f4] border-l border-[#e6e5e0] flex flex-col justify-between p-8 sm:p-12 overflow-y-auto z-[65] shadow-2xl text-left",
            aria_hidden=not is_open,
        ):
            div(className="flex items-center justify-between pb-8 border-b border-[#e6e5e0]"):
                span(className="text-xs font-mono text-[#6c6a64] tracking-[0.88px] uppercase"):
                    "// MENU NAVIGASI"
                div(className="flex items-center gap-4"):
                    button(
                        onClick=close_menu,
                        className="text-xs font-mono text-[#6c6a64] hover:text-[#a9583e] transition-colors cursor-pointer",
                    ):
                        "[TUTUP]"

            ul(className="flex flex-col gap-6 my-auto py-8 list-none"):
                for it in default_items:
                    li(key=it["link"], className="overflow-hidden leading-none"):
                        a(
                            href=it["link"],
                            onClick=lambda e, lid=it["link"]: scroll_to_target(e, lid),
                            className="group flex items-baseline justify-between text-3xl sm:text-4xl font-normal text-[#26251e] hover:text-[#a9583e] transition-colors tracking-tight cursor-pointer",
                        ):
                            span(className="sm-panel-itemLabel inline-block"):
                                it["label"]
                            span(className="sm-panel-num text-xs font-mono text-[#a9583e] opacity-0 transition-opacity"):
                                it["num"]

            div(className="pt-8 border-t border-[#e6e5e0] space-y-3"):
                p(className="text-[11px] font-mono uppercase tracking-[0.88px] text-[#6c6a64]"):
                    "// KONTAK & TAUTAN"
                div(className="flex flex-wrap gap-4"):
                    for s in default_socials:
                        a(
                            key=s["label"],
                            href=s["link"],
                            target="_blank",
                            rel="noreferrer",
                            className="sm-socials-link text-xs font-mono text-[#26251e] hover:text-[#a9583e] transition-colors inline-flex items-center gap-1",
                        ):
                            span(): s["label"]
                            span(className="text-[#a9583e] text-[10px]"): "↗"

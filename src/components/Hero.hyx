# [xihanzu-NR]
from "react" import useState, useEffect, useRef
from "./StrokeText.hyx" import StrokeText
from "./GradientWaves.tsx" import GradientWaves
from "../utils/scrollEngine" import on_scroll, prefers_reduced_motion

component Hero(className=""):
    # Catatan arsitektur:
    # Sebelumnya komponen ini memanggil setState di setiap event `scroll`, jadi
    # React merender ulang tiap kali roda mouse bergerak. Sekarang nilai scroll
    # ditulis langsung ke style elemen lewat satu driver terpusat (scrollEngine),
    # jadi nol render ulang dan animasinya jalan di compositor.
    is_covered, set_is_covered = useState(False)
    text_ref = useRef(None)
    eyebrow_ref = useRef(None)

    # Latar hero sebelumnya `PatternWaves`: shader WebGL (ogl, 963 baris) dengan
    # render loop, dibuat saat mount. Terukur dengan CPU throttle 4x, emulasi
    # ponsel: TBT 9,4 detik, long task terburuk 3 detik, FCP tertahan di 1,36 s.
    # Itu persis keluhan PageSpeed -- Total Blocking Time 30% dari skor.
    #
    # Penggantinya pola titik CSS: dua radial-gradient, nol JavaScript, nol
    # canvas, dan dikerjakan compositor. Yang hilang cuma reaksi pola terhadap
    # kursor; yang didapat halaman yang bisa dipakai sebelum JS selesai.

    def scroll_effect():
        if prefers_reduced_motion():
            return lambda: None

        def handle(frame):
            p = frame.hero
            set_is_covered(p >= 0.999)

            if text_ref.current:
                lift = p * -14
                fade = 1 - Math.min(1, p / 0.72)
                Object.assign(text_ref.current.style, {
                    "transform": f"translate3d(0, {lift:.3f}vh, 0)",
                    "opacity": f"{fade:.3f}",
                })

            if eyebrow_ref.current:
                Object.assign(eyebrow_ref.current.style, {
                    "opacity": f"{Math.max(0.0, 1 - p / 0.34):.3f}",
                    "transform": f"translate3d(0, {p * -26:.2f}px, 0)",
                })

        return on_scroll(handle)

    useEffect(scroll_effect, [])

    def scroll_to(e, target):
        if e and e.preventDefault:
            e.preventDefault()
        el = document.getElementById(target)
        if el:
            el.scrollIntoView({"behavior": "smooth"})

    div(
        className=f"fixed top-0 left-0 right-0 flex justify-center items-center px-5 sm:px-8 max-w-[1300px] mx-auto z-0 {className}",
        style={
            "height": "100svh",
            "width": "100%",
            "visibility": "hidden" if is_covered else "visible",
        }
    ):
        # Latar gelombang. Warna diambil dari token situs, bukan palet bawaan
        # komponen (ungu #5227FF) -- supaya tetap menyatu dengan tema.
        div(className="absolute inset-0 w-full h-full -z-10 pointer-events-none", aria_hidden=True):
            # Settingan dari hanzu, dipakai apa adanya.
            #
            # Palet ungu/pink ini milik komponennya sendiri, bukan token situs.
            # Sudah kusebut di laporan: dengan situs dark-only, ungu di atas
            # hitam terbaca, tapi tidak menyatu dengan aksen terracotta.
            GradientWaves(
                horizonColor="#5227FF",
                waveColor="#FF9FFC",
                crestColor="#FFFFFF",
                speed=0.4,
                amplitude=2.5,
                relief=1,
                lightAngle=120,
                mouseInteraction=True,
                swellOnClick=True,
                lightMode=False,
                waveScale=0.6,
                waveRatio=1.02,
                swell=35,
                turbulence=20,
                tilt=64,
                zoom=1,
                height=5.5,
                fogDepth=15,
                sheen=0,
                brightness=1,
                opacity=1,
                grain=0.2,
                quality="medium",
                intro=True,
                parallaxStrength=0.5,
                mouseStrength=0.6,
                paused=False,
            )

        div(className="w-full h-full flex flex-col justify-center items-center gap-3 sm:gap-5 relative z-10 pointer-events-none"):
            div(
                ref=text_ref,
                className="w-full max-w-3xl flex flex-col justify-center items-center text-center pointer-events-auto relative z-40 will-change-transform",
            ):
                # Scrim: lapisan gelap lembut di belakang teks.
                #
                # Gelombangnya oranye menyala, dan teksnya krem terang --
                # dua-duanya terang, jadi tanpa pemisah nama besar jadi samar
                # (terukur dari screenshot: kontras judul paling rendah di
                # halaman). Scrim ini menurunkan luminansi latar tepat di
                # belakang teks, tanpa menggelapkan seluruh hero.
                div(className="absolute inset-x-0 top-1/2 -translate-y-1/2 h-[85%] -z-10 pointer-events-none hero-scrim", aria_hidden=True)
                p(
                    ref=eyebrow_ref,
                    className="text-[10px] sm:text-[13px] font-mono tracking-[0.6px] uppercase text-[#a9583e] mb-2 sm:mb-2.5 lg:mb-3 will-change-transform",
                ):
                    "// DEVELOPER & SYSTEMS ENTHUSIAST"

                h1(className="mb-2.5 sm:mb-3 lg:mb-4 w-full relative flex justify-center"):
                    span(className="sr-only"): "Reyhan Akhtar Afriansyah"
                    StrokeText(
                        text="Reyhan Akhtar Afriansyah",
                        strokeColor="#cc785c",
                        fillColor="var(--color-ink, #141413)",
                        strokeWidth=1.5,
                        drawDuration=1.5,
                        fillDelay=0.15,
                        fontSize=72,
                        fontWeight=500,
                        letterSpacing=-2,
                    )

                p(className="text-[13px] sm:text-[17px] lg:text-[19px] font-normal leading-[1.5] sm:leading-[1.6] text-[#5a5852] max-w-2xl mb-4 sm:mb-6 lg:mb-8 text-center mx-auto"):
                    "Pengembang yang fokus mendalami web development, pengelolaan server Linux, toolchain compiler, dan perakitan hardware elektronika."

                div(className="flex flex-row flex-wrap items-center justify-center gap-3 w-full sm:w-auto"):
                    a(
                        href="#projects",
                        onClick=lambda e: scroll_to(e, "projects"),
                        className="h-10 sm:h-11 px-5 sm:px-6 inline-flex items-center justify-center rounded-[8px] bg-[#b25f42] text-white text-[13px] sm:text-[14px] font-medium leading-none hover:bg-[#a9583e] transition-colors shadow-sm cursor-pointer",
                    ):
                        span(): "Lihat Proyek"
                        span(className="ml-2 text-xs"): "↓"

                    a(
                        href="#evidence",
                        onClick=lambda e: scroll_to(e, "evidence"),
                        className="h-10 sm:h-11 px-5 sm:px-6 inline-flex items-center justify-center rounded-[8px] bg-white border border-[#cfcdc4] text-[#26251e] text-[13px] sm:text-[14px] font-medium leading-none hover:border-[#26251e] transition-colors cursor-pointer",
                    ):
                        span(): "Lihat Dokumentasi"
                        span(className="ml-2 text-xs"): "→"

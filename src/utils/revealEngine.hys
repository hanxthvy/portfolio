# [xihanzu-NR]
# Reveal saat elemen masuk viewport.
#
# Hanya memakai IntersectionObserver + transisi CSS (transform dan opacity),
# bukan animasi per-frame. Jadi nol biaya JS saat menggulir dan GPU yang
# mengerjakan sisanya -- penting di mesin 2 vCPU.
#
# Prinsip keselamatan: elemen disembunyikan lewat kelas `reveal-pending` yang
# HANYA dipasang pada elemen yang benar-benar sudah masuk daftar pantau. Jadi
# kalau ada elemen yang tidak terpantau (mis. dirender belakangan), dia tetap
# terlihat. Konten yang tak sengaja tersembunyi jauh lebih buruk daripada
# animasi yang tidak jalan.

SELECTOR = "[data-reveal]"
PENDING = "reveal-pending"
DONE = "is-revealed"

_observer = {"io": None}


# HydraScript tidak menerjemahkan pemanggilan konstruktor menjadi `new`.
# `window.IntersectionObserver(...)` karenanya melempar
# "Please use the 'new' operator" -- dan karena dipanggil saat mount, seluruh
# halaman gagal render. Diambil dulu konstruktornya, dipanggil lewat `new`.
def _io_baru(cb, opsi):
    # HydraScript tidak menerjemahkan pemanggilan konstruktor menjadi `new`.
    # `window.IntersectionObserver(cb, opsi)` karenanya melempar
    # "Please use the 'new' operator" -- dan karena dipanggil saat mount,
    # SELURUH halaman gagal render (terukur: 0 elemen, 0 heading).
    #
    # `Reflect.construct` memanggil konstruktor dengan `new` tanpa perlu
    # menulis kata `new` di sumber.
    K = window.IntersectionObserver
    return window.Reflect.construct(K, [cb, opsi])


def _reduced():
    try:
        return window.matchMedia("(prefers-reduced-motion: reduce)").matches
    except:
        return False


def _settle(el):
    if _observer["io"]:
        try:
            _observer["io"].unobserve(el)
        except:
            pass
    el.classList.remove(PENDING)
    el.classList.add(DONE)


def _reveal(el):
    delay = 0
    try:
        delay = int(el.dataset.revealDelay or 0)
    except:
        delay = 0
    if delay > 0:
        window.setTimeout(lambda: _settle(el), delay)
    else:
        _settle(el)


export def on_visible_once(el, fn, threshold=0.25, topMargin=120):
    # Panggil `fn` sekali saat `el` terlihat, lalu berhenti mengamati.
    #
    # `topMargin` memperluas area pengamatan ke ATAS viewport. Alasannya sama
    # seperti pada init_reveal: kalau pengguna menggulir cepat (atau melompat
    # lewat tautan), elemen bisa melewati viewport tanpa pernah dilaporkan
    # intersecting. Untuk coretan judul itu berarti judulnya berhenti separuh
    # tergambar. Dengan margin besar, elemen yang sudah terlewati langsung
    # diselesaikan.
    try:
        if "IntersectionObserver" not in window:
            fn()
            return lambda: None
    except:
        fn()
        return lambda: None

    kotak = {"io": None}

    def saat_masuk(entries):
        for entry in entries:
            if entry.isIntersecting:
                if kotak["io"]:
                    kotak["io"].disconnect()
                fn()

    kotak["io"] = _io_baru(
        saat_masuk,
        {"threshold": threshold, "rootMargin": f"{topMargin}% 0px 0px 0px"},
    )
    kotak["io"].observe(el)
    return lambda: kotak["io"].disconnect()


export def init_reveal():
    try:
        if not window:
            return lambda: None
    except:
        return lambda: None

    semua = document.querySelectorAll(SELECTOR)
    pending = []
    for el in semua:
        if not el.classList.contains(DONE):
            pending.append(el)

    if len(pending) == 0:
        return lambda: None

    # Tanpa IntersectionObserver atau saat pengguna minta minim gerak:
    # tampilkan semuanya tanpa animasi.
    punya_io = True
    try:
        if "IntersectionObserver" not in window:
            punya_io = False
    except:
        punya_io = False

    if not punya_io or _reduced():
        for el in pending:
            el.classList.add(DONE)
        return lambda: None

    # rootMargin atas 120%: elemen yang sudah TERLEWATI (kini di atas viewport)
    # tetap dianggap intersecting. Penting karena kalau pengguna menggulir
    # cepat, IntersectionObserver bisa tidak pernah melaporkan elemen yang
    # masuk dan keluar dalam satu frame -- kalau itu terjadi, elemennya akan
    # tersembunyi selamanya. Dengan margin ini, apa pun yang terlewati selalu
    # ikut terbuka.
    def saat_masuk(entries):
        for entry in entries:
            if entry.isIntersecting:
                _reveal(entry.target)

    io = _io_baru(
        saat_masuk, {"rootMargin": "120% 0px -10% 0px", "threshold": 0.05}
    )
    _observer["io"] = io

    for el in pending:
        # Kelas penyembunyi dipasang di sini, bukan lewat CSS global, supaya
        # elemen yang tidak terpantau tidak pernah ikut tersembunyi.
        el.classList.add(PENDING)
        io.observe(el)

    # Jaring pengaman terakhir: apa pun yang sudah berada di atas viewport
    # dibuka tanpa animasi. Ini menutup semua celah sisa, termasuk elemen yang
    # di-render setelah init_reveal dipanggil.
    jam = {"id": 0}

    def sweep():
        sisa = document.querySelectorAll("." + PENDING)
        for el in sisa:
            try:
                if el.getBoundingClientRect().bottom <= 0:
                    _settle(el)
            except:
                pass
        # Berhenti sendiri setelah tidak ada yang tertunda, supaya tidak ada
        # timer yang jalan terus tanpa alasan.
        if len(document.querySelectorAll("." + PENDING)) == 0:
            window.clearInterval(jam["id"])

    jam["id"] = window.setInterval(sweep, 1000)
    window.addEventListener("load", sweep, {"once": True})

    def bersih():
        window.clearInterval(jam["id"])
        if _observer["io"]:
            try:
                _observer["io"].disconnect()
            except:
                pass
        _observer["io"] = None

    return bersih

# [xihanzu-NR]
from "gsap" import gsap

export def init_menu_gsap(panel, pre_layers, bar1, bar2, bar3):
    try:
        layers = gsap.utils.toArray(pre_layers)
        # Panel TIDAK diposisikan di sini.
        #
        # Dulu `gsap.set(panel, {xPercent: 100})` yang menyembunyikannya. Itu
        # menulis `transform` inline, dan karena itu (a) panel tidak tersembunyi
        # sama sekali kalau JS gagal, dan (b) saat animasi buka jalan, GSAP
        # menganimasikan xPercent dari 100 ke 0 sambil CSS juga menulis
        # `transform` -- dua penulis pada properti yang sama, dan hasil akhirnya
        # panel berhenti di luar layar sehingga isinya tidak pernah terlihat.
        #
        # Sekarang CSS (.nav-panel / .nav-panel.is-open) satu-satunya yang
        # menentukan posisi. GSAP hanya menganimasikan opacity isi panel.
        if panel:
            gsap.set(panel, {"opacity": 1})
        if len(layers) > 0:
            gsap.set(layers, {"xPercent": 100, "opacity": 1})
        if bar1:
            gsap.set(bar1, {"y": 0, "rotate": 0, "transformOrigin": "50% 50%"})
        if bar2:
            gsap.set(bar2, {"opacity": 1, "scaleX": 1})
        if bar3:
            gsap.set(bar3, {"y": 0, "rotate": 0, "transformOrigin": "50% 50%"})
    except:
        pass

export def play_open_menu(panel, pre_layers, on_complete=None):
    try:
        if not panel:
            return None

        layers = gsap.utils.toArray(pre_layers)
        item_els = gsap.utils.toArray(panel.querySelectorAll(".sm-panel-itemLabel"))
        number_els = gsap.utils.toArray(panel.querySelectorAll(".sm-panel-num"))
        social_links = gsap.utils.toArray(panel.querySelectorAll(".sm-socials-link"))

        if len(item_els) > 0:
            gsap.set(item_els, {"yPercent": 140, "rotate": 10})
        if len(number_els) > 0:
            gsap.set(number_els, {"opacity": 0})
        if len(social_links) > 0:
            gsap.set(social_links, {"y": 25, "opacity": 0})

        tl = gsap.timeline({
            "paused": True,
            "onComplete": lambda: on_complete() if on_complete else None,
        })

        if len(layers) > 0:
            layers.forEach(lambda layer, idx: tl.fromTo(layer, {"xPercent": 100}, {"xPercent": 0, "duration": 0.5, "ease": "power4.out"}, idx * 0.07))

        last_time = (len(layers) - 1) * 0.07 if len(layers) > 0 else 0
        panel_start = last_time + (0.08 if len(layers) > 0 else 0)

        # Posisi panel diatur transisi CSS, bukan timeline ini. Yang dianimasikan
        # di sini hanya isi panel, supaya dua sistem tidak berebut `transform`.
        tl.set(panel, {"opacity": 1}, panel_start)

        # Tirai yang sudah masuk harus pergi lagi sebelum isi panel dibaca.
        #
        # Tanpa ini ketiga lapisan berhenti di x=0 dan menutupi seluruh menu
        # selamanya: menu "terbuka" tapi yang terlihat hanya warna paling atas.
        # Yang benar adalah urutan: tirai masuk berjeda, panel selesai bergeser,
        # lalu tirai keluar ke kiri sambil isi panel muncul di belakangnya.
        if len(layers) > 0:
            tl.to(layers, {"xPercent": -100, "duration": 0.5, "ease": "power4.inOut", "stagger": 0.07}, panel_start)

        items_start = panel_start + 0.1
        if len(item_els) > 0:
            tl.to(item_els, {"yPercent": 0, "rotate": 0, "duration": 0.8, "ease": "power4.out", "stagger": 0.08}, items_start)

        if len(number_els) > 0:
            tl.to(number_els, {"opacity": 1, "duration": 0.5, "ease": "power2.out", "stagger": 0.06}, items_start + 0.1)

        if len(social_links) > 0:
            tl.to(social_links, {"y": 0, "opacity": 1, "duration": 0.5, "ease": "power3.out", "stagger": 0.06}, items_start + 0.2)

        tl.play(0)
        return tl
    except:
        return None

export def play_close_menu(panel, pre_layers, on_complete=None):
    try:
        if not panel:
            return None

        layers = gsap.utils.toArray(pre_layers)
        layers_only = list(layers)

        def handle_done():
            item_els = gsap.utils.toArray(panel.querySelectorAll(".sm-panel-itemLabel"))
            if len(item_els) > 0:
                gsap.set(item_els, {"yPercent": 140, "rotate": 10})
            number_els = gsap.utils.toArray(panel.querySelectorAll(".sm-panel-num"))
            if len(number_els) > 0:
                gsap.set(number_els, {"opacity": 0})
            social_links = gsap.utils.toArray(panel.querySelectorAll(".sm-socials-link"))
            if len(social_links) > 0:
                gsap.set(social_links, {"y": 25, "opacity": 0})
            if on_complete:
                on_complete()

        # `targets` sengaja hanya lapisan prelayer. Panel tidak ikut, karena
        # posisinya diatur CSS (.nav-panel). Kalau GSAP menulis xPercent ke panel,
        # ia meninggalkan `transform` inline yang mengalahkan CSS — dan itulah
        # yang membuat panel tetap di luar layar walau kelas `is-open` sudah
        # dipasang lagi.
        panel.style.removeProperty("transform")
        panel.style.removeProperty("translate")

        return gsap.to(layers_only, {
            "xPercent": 100,
            "duration": 0.32,
            "ease": "power3.in",
            "overwrite": "auto",
            "onComplete": handle_done,
        })
    except:
        return None

export def animate_hamburger(bar1, bar2, bar3, opening):
    try:
        if not bar1 or not bar2 or not bar3:
            return None
        tl = gsap.timeline({"defaults": {"ease": "power4.out" if opening else "power3.inOut"}})
        if opening:
            # 3 bars collapse to X: bar1 down 6px & rotate 45, bar2 fade out, bar3 up 6px & rotate -45
            tl.to(bar1, {"y": 6, "rotate": 45, "duration": 0.35}, 0)
            tl.to(bar2, {"opacity": 0, "scaleX": 0, "duration": 0.2}, 0)
            tl.to(bar3, {"y": -6, "rotate": -45, "duration": 0.35}, 0)
        else:
            tl.to(bar1, {"y": 0, "rotate": 0, "duration": 0.3}, 0)
            tl.to(bar2, {"opacity": 1, "scaleX": 1, "duration": 0.25}, 0.05)
            tl.to(bar3, {"y": 0, "rotate": 0, "duration": 0.3}, 0)
        return tl
    except:
        return None

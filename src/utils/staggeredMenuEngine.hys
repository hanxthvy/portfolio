# [xihanzu-NR]
# Port dari React Bits `StaggeredMenu`.
#
# Sumber: https://reactbits.dev/components/staggered-menu
# Perilaku di bawah ini sengaja meniru timeline aslinya, termasuk angka
# durasi, easing, dan jeda antar lapisan. Jangan diubah tanpa membandingkan
# dengan sumbernya, karena beda 50 ms saja sudah terasa berbeda.
from "gsap" import gsap


# Jumlah elemen tengah dibuang kalau warnanya tiga atau lebih.
#
# Ini perilaku asli, bukan kekurangan: dengan tiga lapis warnanya jadi terlalu
# ramai dan panel putih menutupi semuanya sebelum sempat terbaca sebagai pita.
# Hasilnya dua lapis.
export def trim_colors(colors):
    arr = list(colors)
    if len(arr) >= 3:
        mid = len(arr) // 2
        arr.pop(mid)
    return arr


export def init_menu_gsap(panel, pre_layers, bar1, bar2, bar3):
    try:
        layers = gsap.utils.toArray(pre_layers)

        # Panel dan tirai disembunyikan dengan `xPercent`, seperti aslinya.
        #
        # `opacity: 1` dipasang di sini karena CSS menyimpannya di 0 sebagai
        # jaring pengaman untuk kondisi tanpa JS. Tanpa JS panel memang tidak
        # bisa dibuka, jadi ia harus tidak terlihat; dengan JS, GSAP yang
        # menyalakannya.
        if panel:
            gsap.set(panel, {"xPercent": 100, "opacity": 1})
        if len(layers) > 0:
            gsap.set(layers, {"xPercent": 100, "opacity": 1})
        if bar1:
            gsap.set(bar1, {"y": 0, "rotate": 0, "transformOrigin": "50% 50%"})
        if bar2:
            gsap.set(bar2, {"opacity": 1, "scaleX": 1})
        if bar3:
            gsap.set(bar3, {"y": 0, "rotate": 0, "transformOrigin": "50% 50%"})
        return True
    except:
        return None


export def play_open_menu(panel, pre_layers, on_complete=None):
    try:
        if not panel:
            return None

        layers = gsap.utils.toArray(pre_layers)
        item_els = gsap.utils.toArray(panel.querySelectorAll(".sm-panel-itemLabel"))
        number_els = gsap.utils.toArray(panel.querySelectorAll(".sm-panel-num"))
        social_links = gsap.utils.toArray(panel.querySelectorAll(".sm-socials-link"))

        # Keadaan awal isi panel. Sama persis dengan aslinya: label datang dari
        # bawah sambil sedikit miring, nomor dan tautan sosial dari transparan.
        if len(item_els) > 0:
            gsap.set(item_els, {"yPercent": 140, "rotate": 10})
        if len(number_els) > 0:
            gsap.set(number_els, {"opacity": 0})
        if len(social_links) > 0:
            gsap.set(social_links, {"y": 25, "opacity": 0})

        tl = gsap.timeline({
            "paused": True,
            "onComplete": lambda: on_complete() if on_complete else None,
        })

        # 1. Tirai warna masuk satu per satu, 70 ms jeda, 0.5 s masing-masing.
        if len(layers) > 0:
            layers.forEach(lambda layer, idx: tl.fromTo(
                layer,
                {"xPercent": 100},
                {"xPercent": 0, "duration": 0.5, "ease": "power4.out"},
                idx * 0.07,
            ))

        # 2. Panel menyusul, 80 ms setelah tirai terakhir mulai, 0.65 s.
        last_time = (len(layers) - 1) * 0.07 if len(layers) > 0 else 0
        panel_insert = last_time + (0.08 if len(layers) > 0 else 0)
        panel_duration = 0.65

        tl.fromTo(
            panel,
            {"xPercent": 100},
            {"xPercent": 0, "duration": panel_duration, "ease": "power4.out"},
            panel_insert,
        )

        # 3. Label menu naik ke tempatnya, mulai 15% dari durasi panel.
        if len(item_els) > 0:
            items_start = panel_insert + panel_duration * 0.15
            tl.to(
                item_els,
                {"yPercent": 0, "rotate": 0, "duration": 1, "ease": "power4.out", "stagger": 0.1},
                items_start,
            )
            if len(number_els) > 0:
                tl.to(
                    number_els,
                    {"opacity": 1, "duration": 0.6, "ease": "power2.out", "stagger": 0.08},
                    items_start + 0.1,
                )

        # 4. Tautan sosial, mulai 40% dari durasi panel.
        if len(social_links) > 0:
            socials_start = panel_insert + panel_duration * 0.4
            tl.to(
                social_links,
                {"y": 0, "opacity": 1, "duration": 0.55, "ease": "power3.out", "stagger": 0.08},
                socials_start + 0.04,
            )

        tl.play(0)
        return tl
    except:
        return None


export def play_close_menu(panel, pre_layers, on_complete=None):
    try:
        if not panel:
            return None

        layers = gsap.utils.toArray(pre_layers)

        # Panel dan tirai sama-sama mundur ke kanan, 0.32 s. Aslinya tidak
        # menyapu tirai ke kiri setelah terbuka -- tirai memang tetap di
        # belakang panel dan baru ikut pergi saat menu ditutup.
        targets = [panel] + list(layers)

        def handle_done():
            item_els = gsap.utils.toArray(panel.querySelectorAll(".sm-panel-itemLabel"))
            if len(item_els) > 0:
                gsap.set(item_els, {"yPercent": 140, "rotate": 10})
            number_els = gsap.utils.toArray(panel.querySelectorAll(".sm-panel-num"))
            if len(number_els) > 0:
                gsap.set(number_els, {"opacity": 0})
            social_links = gsap.utils.toArray(panel.querySelectorAll(".sm-socials-link"))
            if len(social_links) > 0:
                gsap.set(social_links, {"y": 25, "opacity": 0})
            if on_complete:
                on_complete()

        return gsap.to(targets, {
            "xPercent": 100,
            "duration": 0.32,
            "ease": "power3.in",
            "overwrite": "auto",
            "onComplete": handle_done,
        })
    except:
        return None


export def animate_hamburger(bar1, bar2, bar3, opening):
    try:
        if not bar1 or not bar2 or not bar3:
            return None
        tl = gsap.timeline({"defaults": {"ease": "power4.out" if opening else "power3.inOut"}})
        if opening:
            tl.to(bar1, {"y": 6, "rotate": 45, "duration": 0.35}, 0)
            tl.to(bar2, {"opacity": 0, "scaleX": 0, "duration": 0.2}, 0)
            tl.to(bar3, {"y": -6, "rotate": -45, "duration": 0.35}, 0)
        else:
            tl.to(bar1, {"y": 0, "rotate": 0, "duration": 0.3}, 0)
            tl.to(bar2, {"opacity": 1, "scaleX": 1, "duration": 0.3}, 0)
            tl.to(bar3, {"y": 0, "rotate": 0, "duration": 0.3}, 0)
        return tl
    except:
        return None

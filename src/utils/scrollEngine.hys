# [xihanzu-NR]
# Scroll driver tunggal untuk seluruh halaman.
#
# Kenapa ada: sebelumnya tiap komponen memasang listener `scroll` sendiri lalu
# memanggil setState, sehingga React merender ulang setiap event (bisa ratusan
# kali per detik) -- di mesin 2 vCPU ini yang bikin animasi scroll tersendat.
#
# Di sini hanya SATU listener pasif, dan nilainya dibagikan lewat callback yang
# dipanggil di dalam requestAnimationFrame. Tidak ada state React, jadi tidak
# ada render ulang: konsumen menulis langsung ke style/transform elemennya.
#
# Frame yang dibagikan punya bentuk:
#   progress  -- 0 di paling atas, 1 di paling bawah dokumen
#   y         -- window.scrollY saat ini
#   velocity  -- perubahan piksel per milidetik pada frame ini (bisa negatif)
#   hero      -- progress dibatasi pada viewport pertama (0..1 sepanjang 100vh)

# Kecepatan tidak boleh langsung nol begitu gulir berhenti.
#
# Kalau dibiarkan: event scroll berhenti, jadi kerangka terakhir yang
# dilaporkan punya kecepatan besar dan nilai itu menempel selamanya -- kartu
# lanyard akan terus terembus padahal halaman sudah diam.
# Kalau pula langsung dinolkan: animasi terasa terputus.
# Jadi diluruhkan terhadap waktu (bukan per frame), supaya hasilnya sama
# di laptop 144Hz maupun di mesin ini.
DECAY_MS = 110.0
FLOOR = 0.015

# Semua state disimpan di satu dict. Modul .hys tidak punya `let` tingkat modul
# seperti TS, dan variabel yang di-assign ulang di dalam fungsi butuh wadah
# bersama supaya perubahannya terlihat oleh fungsi lain.
_s = {
    "listeners": [],
    "raf": 0,
    "lastY": 0.0,
    "lastTime": 0.0,
    "running": False,
}


def _frame():
    # Objek frame dipakai ulang, bukan dibuat baru tiap frame: konsumen
    # membacanya langsung, tidak menyimpannya.
    if "obj" not in _s:
        _s["obj"] = {"progress": 0.0, "y": 0.0, "velocity": 0.0, "hero": 0.0}
    return _s["obj"]


def _compute(now):
    try:
        y = window.scrollY or 0
    except:
        y = 0
    max_y = 1.0
    try:
        tinggi = document.documentElement.scrollHeight or 0
        max_y = tinggi - window.innerHeight
        if max_y < 1:
            max_y = 1.0
    except:
        max_y = 1.0

    dt = 16.0
    if _s["lastTime"]:
        dt = now - _s["lastTime"]
        if dt < 1:
            dt = 1.0

    f = _frame()
    moved = y != _s["lastY"]
    if moved:
        f["velocity"] = (y - _s["lastY"]) / dt
    elif f["velocity"] != 0:
        f["velocity"] = f["velocity"] * _damp(dt / DECAY_MS)
        if abs(f["velocity"]) <= FLOOR:
            f["velocity"] = 0.0

    _s["lastY"] = y
    _s["lastTime"] = now
    f["y"] = y
    f["progress"] = min(1.0, max(0.0, y / max_y))
    vh = 1.0
    try:
        vh = window.innerHeight or 1
    except:
        vh = 1.0
    f["hero"] = min(1.0, max(0.0, y / max(vh, 1)))
    return f


def _damp(x):
    # e^(-x). Dipakai untuk meluruhkan kecepatan terhadap waktu.
    try:
        return Math.exp(-x)
    except:
        # Kalau `Math` tidak tersedia (lingkungan tanpa JS global): deret.
        # cukup akurat untuk rentang x 0..1 yang dipakai di sini.
        return 1.0 / (1.0 + x + 0.5 * x * x)


def _schedule():
    if _s["raf"] == 0 and _s["running"]:
        _s["raf"] = window.requestAnimationFrame(_pump)


def _pump(now):
    _s["raf"] = 0
    if not _s["running"]:
        return
    current = _compute(now)
    for fn in list(_s["listeners"]):
        try:
            fn(current)
        except:
            # satu konsumen gagal tidak boleh mematikan sisanya
            pass
    # Lanjutkan hanya selama masih ada kecepatan yang perlu diluruhkan.
    if current["velocity"] != 0:
        _schedule()


def _on_native(_=None):
    _schedule()


def _on_visibility(_=None):
    try:
        hidden = document.hidden
    except:
        hidden = False
    if hidden:
        # Hemat baterai: berhenti menjadwalkan frame saat tab tidak terlihat.
        if _s["raf"]:
            try:
                window.cancelAnimationFrame(_s["raf"])
            except:
                pass
            _s["raf"] = 0
    else:
        _s["lastTime"] = 0.0
        _schedule()


def _start():
    if _s["running"]:
        return
    _s["running"] = True
    try:
        _s["lastY"] = window.scrollY or 0
    except:
        _s["lastY"] = 0.0
    _s["lastTime"] = 0.0
    window.addEventListener("scroll", _on_native, {"passive": True})
    window.addEventListener("resize", _on_native, {"passive": True})
    document.addEventListener("visibilitychange", _on_visibility)
    _schedule()


export def on_scroll(fn):
    # Berlangganan frame scroll. Mengembalikan fungsi untuk berhenti.
    try:
        if not window:
            return lambda: None
    except:
        return lambda: None

    if not _s["running"]:
        _start()
    _s["listeners"].append(fn)
    fn(_compute(window.performance.now()))

    def berhenti():
        try:
            _s["listeners"].remove(fn)
        except:
            pass
        if len(_s["listeners"]) == 0:
            window.removeEventListener("scroll", _on_native)
            window.removeEventListener("resize", _on_native)
            document.removeEventListener("visibilitychange", _on_visibility)
            if _s["raf"]:
                try:
                    window.cancelAnimationFrame(_s["raf"])
                except:
                    pass
                _s["raf"] = 0
            _s["running"] = False
            _frame()["velocity"] = 0.0

    return berhenti


export def prefers_reduced_motion():
    try:
        return window.matchMedia("(prefers-reduced-motion: reduce)").matches
    except:
        return False


export def scroll_progress():
    return _frame()["progress"]


export def hero_progress():
    return _frame()["hero"]

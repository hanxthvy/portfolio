# [xihanzu-NR]
# Geometri sapuan lingkaran. Bagian yang harus dihitung, bukan diwarisi.

export def viewport_radius():
    # Radius minimum supaya lingkaran berpusat di satu sudut menutupi seluruh
    # layar. Titik terjauh dari sudut adalah sudut seberangnya, jadi jaraknya
    # adalah diagonal viewport, dan diameternya minimal sepanjang itu.
    try:
        w = window.innerWidth
        h = window.innerHeight
        return (w * w + h * h) ** 0.5 / 2
    except:
        return 1200.0


export def corner_offset(corner, radius):
    # Pusat lingkaran untuk tiap sudut, digeser keluar sejauh radius supaya
    # tepi luarnya tepat menyentuh sudut layar pada saat skala 0.
    if corner == "top-left":
        return (-radius, -radius)
    if corner == "top-right":
        return (radius, -radius)
    if corner == "bottom-left":
        return (-radius, radius)
    return (radius, radius)


export def pick_corner(target, index):
    # Sudut dipilih bergantian supaya transisi tidak terasa monoton saat
    # beberapa section dibuka berurutan.
    corners = ["bottom-right", "top-left", "top-right", "bottom-left"]
    return corners[index % len(corners)]
